<Window x:Class="quasar_radio.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:quasar_radio"
        Title="Programación - Quasar Radio"
        Width="1180" Height="780" MinWidth="900" MinHeight="560"
        Background="{DynamicResource Brush.Surface.Base}" Foreground="{DynamicResource Brush.Text.Default}">

    <!-- UI-4 paso C: la rejilla horaria. Vista SEMANA (7 dias x 24 horas) y vista DIA
         (las 24 horas del dia elegido) sobre la misma rejilla de celdas, con el editor a la
         derecha y las tandas debajo del editor.

         Las filas NO llevan altura fija: el contenido de la rejilla se encola a la altura
         visible del ScrollViewer, así las 24 horas entran siempre de una mirada y la columna de
         horas y las celdas quedan alineadas porque comparten el mismo reparto. Con alturas
         fijas de 30 px la vista día no cabía en una ventana maximizada de 876 px de alto y las
         horas 21, 22 y 23 quedaban detrás de la barra de desplazamiento (verificado en vivo
         2026-10-23: solo 21 de 24 celdas estaban en pantalla). Por debajo de MinHeight sí
         aparece la barra, que es lo que debe pasar en una ventana muy baja. -->
    <Window.Resources>
        <Style x:Key="GridHourLabel" TargetType="TextBlock" BasedOn="{StaticResource Quasar.Label}">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,6,1" />
            <Setter Property="FontFamily" Value="{StaticResource Sys.Font.Clock}" />
            <Setter Property="FontSize" Value="10" />
        </Style>

        <Style x:Key="GridColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource Quasar.Label}">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Una celda de la rejilla es un boton: se elige con un clic y se edita a la derecha. -->
        <Style x:Key="ScheduleCellButton" TargetType="Button">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Padding" Value="3,1" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Inset}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Box" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Mark" Grid.Column="0" CornerRadius="2,0,0,2"
                                        Background="{DynamicResource Brush.Border.Subtle}" />
                                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Border.Highlight}" />
                            </Trigger>

                            <!-- La pauta manda el color del testigo lateral. -->
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScheduleKind.Hora}">
                                <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.Accent.Info}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScheduleKind.Cart}">
                                <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.Accent.Purple}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScheduleKind.Tanda}">
                                <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.Accent.Orange}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ScheduleKind.AutoPlaylist}">
                                <Setter TargetName="Mark" Property="Background" Value="{DynamicResource Brush.Accent.Success}" />
                            </DataTrigger>

                            <DataTrigger Binding="{Binding HasSlot}" Value="False">
                                <Setter TargetName="Mark" Property="Opacity" Value="0.25" />
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsNow}" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Surface.Header}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Selection.Deep}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ScheduleCellTemplate">
            <Button Style="{StaticResource ScheduleCellButton}"
                    Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <Button.ToolTip>
                    <TextBlock Text="{Binding AutomationName}" />
                </Button.ToolTip>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}" FontSize="9" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Detail}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DataContext.IsDayView, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- Las cinco fichas de pauta. Son botones y no un ComboBox por dos motivos: elegir
             qué suena es la decision central de la pantalla y se tiene a la vista con un clic,
             y porque el desplegable de WPF vive en su propio HWND y volverse a manejar por UIA
             (o por teclado desde una prueba) es poco fiable. La ficha elegida se pinta igual
             que una celda seleccionada, para que la vista y la rejilla hablen igual. -->
        <Style x:Key="KindChip" TargetType="Button" BasedOn="{StaticResource Quasar.ActionChip}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.Selection.Deep}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= CABECERA ================= -->
        <Border Grid.Row="0" Style="{StaticResource Quasar.Card}" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="PROGRAMACIÓN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" />
                    <TextBlock Text="Rejilla horaria: qué suena en cada hora de cada día" FontSize="10"
                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Los tres textos de cabecera van por x:Name (AutomationId) y sin
                         AutomationProperties.Name: en un TextBlock el Nombre ES el valor, y
                         etiquetarlo taparia justo lo que hay que leer (lección de las pruebas
                         de Biblioteca y de la consola). -->
                    <TextBlock x:Name="ProgrammedText" Text="{Binding ProgrammedText}" Style="{StaticResource Quasar.Label}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock x:Name="NextDueText" Text="{Binding NextDueText}" FontSize="10" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Accent.Orange}" Margin="0,0,10,0" />
                    <Button Content="{Binding ViewButtonText}" Command="{Binding ToggleViewCommand}"
                            Style="{StaticResource StudioButtonStyle}" Padding="9,4" FontSize="11"
                            AutomationProperties.Name="Cambiar entre vista día y vista semana" />
                    <Button Content="GUARDAR" Command="{Binding SaveCommand}"
                            Style="{StaticResource SuccessButtonStyle}" Padding="9,4" FontSize="11" Margin="6,0,0,0"
                            AutomationProperties.Name="Guardar programacion" />
                    <Button Content="RECARGAR" Command="{Binding ReloadCommand}"
                            Style="{StaticResource StudioButtonStyle}" Padding="9,4" FontSize="11" Margin="6,0,0,0"
                            AutomationProperties.Name="Volver a leer schedule.json" />
                </StackPanel>

                <!-- Selector de dia: en la vista semana salta al dia elegido. -->
                <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding DayPicker}"
                              VerticalAlignment="Center" Margin="0,0,10,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}"
                                    Command="{Binding DataContext.PickDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Day}"
                                    Style="{StaticResource StudioButtonStyle}" Width="26" Height="24"
                                    Margin="1,0" FontSize="10" Padding="0"
                                    AutomationProperties.Name="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ================= CUERPO: rejilla + editor ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="372" />
            </Grid.ColumnDefinitions>

            <!-- La rejilla. Etiquetas de hora y celdas comparten ScrollViewer para que
                 la columna de la izquierda no se desalinee al bajar. -->
            <Border Grid.Column="0" Style="{StaticResource Quasar.Card}" Padding="8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="hora" Style="{StaticResource GridColumnHeader}"
                                   TextAlignment="Right" Margin="0,0,6,0" />

                        <!-- En la vista semana la cabecera son las siete letras de los dias,
                             alineadas con las columnas de la rejilla (mismos ItemsPanel y
                             Columns=7); en la vista dia sobra la letra y va el nombre. -->
                        <Grid Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding DayHeaderLabels}"
                                          Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource GridColumnHeader}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding DayTitle}" Style="{StaticResource GridColumnHeader}"
                                       Visibility="{Binding IsDayView, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Grid>

                    <!-- La altura del contenido se encola a la altura visible del ScrollViewer:
                         así el UniformGrid reparte las 24 filas en lo que hay de ventana y la
                         jornada completa cabe sin desplazar. MinHeight deja que en una ventana
                         muy baja vuelva a aparecer la barra antes de aplastar las celdas. -->
                    <ScrollViewer x:Name="GridScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Height="{Binding ViewportHeight, ElementName=GridScroll}" MinHeight="500">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ItemsControl Grid.Column="0" ItemsSource="{Binding HourLabels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Style="{StaticResource GridHourLabel}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- DOS rejillas, no una que se vacía y se rellena. Medido el
                                 2026-10-23: al hacer Reset de la colección (Clear + Add) sobre un
                                 único ItemsControl, WPF dejaba de publicar los últimos tres
                                 contenedores en el árbol de accesibilidad — 21 botones de 24 en la
                                 vista día y 165 de 168 al volver a la semana, estable durante 18 s
                                 y volviendo a resolver la raíz de UIA en cada lectura. Con dos
                                 ItemsControls fijos que se alternan por Visibility, cada uno genera
                                 sus contenedores una vez y la celda que se edita se actualiza por
                                 notificación de propiedad, nunca por cambio de ítems. -->
                            <ItemsControl Grid.Column="1" x:Name="ScheduleWeekGrid"
                                          ItemsSource="{Binding WeekCells}"
                                          ItemTemplate="{StaticResource ScheduleCellTemplate}"
                                          Visibility="{Binding IsWeekView, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.Name="Rejilla horaria de la emisora">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="7" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <ItemsControl Grid.Column="1" x:Name="ScheduleDayGrid"
                                          ItemsSource="{Binding DayCells}"
                                          ItemTemplate="{StaticResource ScheduleCellTemplate}"
                                          Visibility="{Binding IsDayView, Converter={StaticResource BoolToVis}}"
                                          AutomationProperties.Name="Rejilla del día">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Panel derecho: editor de la celda + tandas -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource Quasar.Card}">
                        <StackPanel>
                            <TextBlock Text="CELA ELEGIDA" Style="{StaticResource Quasar.CardHeader}" />
                            <TextBlock x:Name="SelectedCellTitle" Text="{Binding SelectedTitle}" FontSize="13" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding Selected.Detail}" Style="{StaticResource Quasar.Label}"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Pauta" Style="{StaticResource Quasar.FieldLabel}" />
                            <ItemsControl ItemsSource="{Binding KindChips}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Style="{StaticResource KindChip}"
                                                Command="{Binding DataContext.PickKindCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Value}"
                                                AutomationProperties.Name="{Binding Name}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding ShowRefPicker, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Referencia" Style="{StaticResource Quasar.FieldLabel}" />
                                <TextBox Style="{StaticResource Quasar.Field}"
                                         Text="{Binding EditRef, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Referencia de la pauta" />
                                <!-- El texto de ayuda va por x:Name y sin AutomationProperties.Name:
                                     en un TextBlock el Nombre de UIA ES el valor. -->
                                <TextBlock x:Name="RefHintText" Text="{Binding RefHint}" FontSize="9" Margin="0,2,0,0"
                                           Foreground="{DynamicResource Brush.Text.Faint}" TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Minuto" Style="{StaticResource Quasar.FieldLabel.Inline}" />
                                <TextBox Grid.Column="1" Style="{StaticResource Quasar.Field}"
                                         Text="{Binding EditMinute, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Minuto de la celda" />
                                <TextBlock Grid.Column="3" Text="Hasta" Style="{StaticResource Quasar.FieldLabel.Inline}" />
                                <TextBox Grid.Column="4" Style="{StaticResource Quasar.Field}"
                                         Text="{Binding RangeEndHour, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Hora hasta la que rellena el rango" />
                            </Grid>
                            <!-- La aclaración va en su propia linea: metida en la columna que
                                 sobra del «Hasta» se cortaba a la mitad en el panel de 372 px. -->
                            <TextBlock Text="(horas del día de la celda elegida, 0 a 23)" FontSize="9"
                                       Margin="0,2,0,0" Foreground="{DynamicResource Brush.Text.Faint}" />

                            <CheckBox Content="Activa (si se desactiva, la celda se queda en la rejilla pero no suena)"
                                      IsChecked="{Binding EditEnabled}" Margin="0,8,0,0" FontSize="10"
                                      Foreground="{DynamicResource Brush.Text.Secondary}"
                                      AutomationProperties.Name="Pauta activa" />

                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="✔ APLICAR A LA CELDA" Command="{Binding ApplyCellCommand}"
                                        Style="{StaticResource Quasar.ActionChip}"
                                        AutomationProperties.Name="Aplicar la pauta a la celda elegida" />
                                <Button Content="✖ QUITAR" Command="{Binding ClearCellCommand}"
                                        Style="{StaticResource DangerButtonStyle}" Padding="9,3" FontSize="11"
                                        Margin="0,0,6,6"
                                        AutomationProperties.Name="Quitar la pauta de la celda elegida" />
                                <Button Content="⧉ COPIAR" Command="{Binding CopyCellCommand}"
                                        Style="{StaticResource Quasar.ActionChip}"
                                        AutomationProperties.Name="Copiar la celda elegida" />
                                <Button Content="📋 PEGAR" Command="{Binding PasteCellCommand}"
                                        Style="{StaticResource Quasar.ActionChip}"
                                        AutomationProperties.Name="Pegar la celda copiada en la elegida" />
                                <Button Content="↔ RELLENAR HASTA" Command="{Binding FillRangeCommand}"
                                        Style="{StaticResource Quasar.ActionChip}"
                                        AutomationProperties.Name="Rellenar el rango de horas del dia" />
                                <Button Content="🗓 A TODA LA SEMANA" Command="{Binding ApplyToWeekCommand}"
                                        Style="{StaticResource Quasar.ActionChip}"
                                        AutomationProperties.Name="Aplicar la pauta a la misma hora los siete dias" />
                            </WrapPanel>

                            <TextBlock x:Name="ClipboardText" Style="{StaticResource Quasar.Label}" Margin="0,4,0,0"
                                       Text="{Binding ClipboardText, StringFormat='Portapapeles: {0}'}" />
                        </StackPanel>
                    </Border>

                    <!-- Tandas: lo que ya había en el módulo, con el mismo lanzado de la consola. -->
                    <Border Style="{StaticResource Quasar.Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock DockPanel.Dock="Left" Text="TANDAS COMERCIALES" Style="{StaticResource Quasar.CardHeader}" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CommercialBlocks.Count, StringFormat='{}{0} tandas'}"
                                           FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Orange}" />
                            </DockPanel>

                            <ListBox ItemsSource="{Binding CommercialBlocks}" Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Lista de tandas comerciales">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Quasar.Card}" Padding="8,5" Margin="0,2">
                                            <StackPanel>
                                                <DockPanel LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" FontWeight="Bold"
                                                               FontSize="12" Foreground="{DynamicResource Brush.Text.High}" />
                                                    <Button DockPanel.Dock="Right" Content="📢 LANZAR"
                                                            Command="{Binding DataContext.TriggerBlockNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource CommercialButtonStyle}"
                                                            Padding="6,2" FontSize="9"
                                                            AutomationProperties.Name="Lanzar esta tanda ahora" />
                                                </DockPanel>
                                                <DockPanel Margin="0,2,0,0" LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding ScheduleText}" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Accent.Warn}"
                                                               FontFamily="{StaticResource Sys.Font.Clock}" />
                                                    <TextBlock DockPanel.Dock="Right" FontSize="10"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               Text="{Binding Spots.Count, StringFormat='{}{0} cuña(s) · {1}'}" />
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Button Content="+ Agregar cuña" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.AddSpotToBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource StudioButtonStyle}" Padding="6,2" FontSize="9"
                                                            AutomationProperties.Name="Agregar cuña a esta tanda" />
                                                    <Button Content="🗓 PONER EN LA CELDA" Margin="6,0,0,0" HorizontalAlignment="Left"
                                                            Command="{Binding DataContext.ScheduleBlockHereCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource StudioButtonStyle}" Padding="6,2" FontSize="9"
                                                            AutomationProperties.Name="Programar esta tanda en la celda elegida" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock Style="{StaticResource Quasar.Label}" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Text="«🗓 PONER EN LA CELDA» programa esa tanda en la celda elegida, en el minuto que tiene la tanda. Para un cart, escribe su atajo (F1 a F12) en Referencia." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= ESTADO ================= -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="6"
                BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1" Padding="10,6" Margin="0,10,0,0">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="ESTADO" FontSize="10" FontWeight="Bold"
                           Foreground="{DynamicResource Brush.Text.Faint}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock x:Name="ScheduleStatusText" Text="{Binding StatusText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource Brush.Text.Default}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
