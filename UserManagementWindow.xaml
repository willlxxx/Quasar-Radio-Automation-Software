<Window x:Class="quasar_radio.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usuarios y roles" Height="470" Width="540"
        WindowStartupLocation="CenterOwner" Background="#10151B" Foreground="#E8EEF2">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="USUARIOS" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12"/>
        <DataGrid x:Name="UsersGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  Background="#172129" Foreground="#E8EEF2" BorderBrush="#33434E" RowBackground="#172129" AlternatingRowBackground="#1D2A32">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Usuario" Binding="{Binding Username}" Width="*"/>
                <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBox x:Name="UsernameBox" Height="32" Padding="8,5" ToolTip="Nombre de usuario" Background="#1B252D" Foreground="#FFFFFF" BorderBrush="#33434E"/>
                <PasswordBox x:Name="PasswordBox" Height="32" Padding="8,5" Margin="0,6,0,0" ToolTip="Contraseña (mínimo 10 caracteres)" Background="#1B252D" Foreground="#FFFFFF" BorderBrush="#33434E"/>
            </StackPanel>
            <ComboBox x:Name="RoleBox" Grid.Column="1" Height="32" Margin="0,0,10,0" VerticalAlignment="Top"/>
            <Button Grid.Column="2" Content="CREAR CUENTA" Height="32" VerticalAlignment="Top" Background="#007D75" Foreground="White" BorderThickness="0" FontWeight="Bold" Click="OnCreateClick"/>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,78,0,0" Foreground="#FF7B72" TextWrapping="Wrap"/>
    </Grid>
</Window>
