<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================
         CONTROLES · Estilos compartidos de Quasar Radio Pro
         =====================================================================
         Todo lo que aqui hay usa DynamicResource sobre los tokens, de modo que
         al cambiar de tema se refresca sin tocar una linea de codigo.
         Los estilos SIN x:Key son implicitos: aplican a todas las ventanas.
         ====================================================================== -->

    <!-- ====================== BARRA DE DESPLAZAMIENTO ====================== -->
    <Style x:Key="Quasar.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Brush.Border.Highlight}"
                            CornerRadius="3" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Deep}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Quasar.ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== BOTON DE ESTUDIO ====================== -->
    <Style x:Key="Quasar.Button.Base" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo implicito y alias historicos: las vistas ya referencian estos
         nombres, y en UI-3 se escribiran contra Quasar.Button.* -->
    <Style TargetType="Button" BasedOn="{StaticResource Quasar.Button.Base}" />
    <Style TargetType="Button" x:Key="StudioButtonStyle" BasedOn="{StaticResource Quasar.Button.Base}" />

    <Style TargetType="Button" x:Key="PlayButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Play}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Success}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Success}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="StopButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Stop}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="NextButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Cue}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.CueStrong}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.CueStrong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="CommercialButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.OrangeDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Orange}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Orange}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- El color del boton de micro lo decide el estado, no el tema -->
    <Style TargetType="Button" x:Key="MicButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{Binding MicButtonColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Danger}" />
    </Style>

    <!-- ====================== CAJAS Y CABECERAS ====================== -->
    <Style TargetType="Border" x:Key="Quasar.Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Quasar.SectionHeader">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Quasar.Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Texto por defecto de la ventana: evita el negro de WPF en temas oscuros -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Deep}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selection.Deep}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: la plantilla por defecto de WPF pinta su propio chrome claro y
         ignora el Background, de modo que el texto seleccionada quedaba ilegible
         sobre tema oscuro. Se plantilla completa. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Chrome" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box"
                                            Background="{DynamicResource Brush.Surface.Raised}"
                                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 8 8 L 16 0 Z"
                                                  Fill="{DynamicResource Brush.Text.Secondary}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource Brush.Surface.Panel}"
                                    BorderBrush="{DynamicResource Brush.Border.Highlight}"
                                    BorderThickness="1" CornerRadius="0,0,4,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Chrome" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Deep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Highlight}" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <!-- ====================== TABLAS ====================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Header}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Header}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Deep}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ====================== DECKS (identidad A/B, invariante al tema) ====================== -->
    <Style x:Key="DeckGlowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.GlowBorder}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="{DynamicResource Color.Glow.A}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="{DynamicResource Color.Glow.A}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Purple}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="{DynamicResource Color.Glow.B}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeckAActiveChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.DeckA.Chip.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckA.Chip.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DeckA.Chip.ActiveSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckA.Chip.ActiveBorder}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeckBActiveChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.DeckB.Chip.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckB.Chip.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DeckB.Chip.ActiveSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckB.Chip.ActiveBorder}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
