<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================
         CONTROLES · Estilos compartidos de Quasar Radio Pro
         =====================================================================
         Todo lo que aqui hay usa DynamicResource sobre los tokens, de modo que
         al cambiar de tema se refresca sin tocar una linea de codigo.
         Los estilos SIN x:Key son implicitos: aplican a todas las ventanas.
         ====================================================================== -->

    <!-- ====================== BARRA DE DESPLAZAMIENTO ====================== -->
    <Style x:Key="Quasar.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource Brush.Border.Highlight}"
                            CornerRadius="3" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Deep}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Quasar.ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                            </Track.IncreaseRepeatButton>
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                            </Track.DecreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto" />
                            <Setter Property="Height" Value="10" />
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ====================== BOTON DE ESTUDIO ====================== -->
    <Style x:Key="Quasar.Button.Base" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Shell" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Estilo implicito y alias historicos: las vistas ya referencian estos
         nombres, y en UI-3 se escribiran contra Quasar.Button.* -->
    <Style TargetType="Button" BasedOn="{StaticResource Quasar.Button.Base}" />
    <Style TargetType="Button" x:Key="StudioButtonStyle" BasedOn="{StaticResource Quasar.Button.Base}" />

    <Style TargetType="Button" x:Key="PlayButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Play}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Success}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Success}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="StopButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Stop}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="NextButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Cue}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.CueStrong}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.CueStrong}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="CommercialButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.OrangeDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Orange}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Orange}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- El color del boton de micro lo decide el estado, no el tema -->
    <Style TargetType="Button" x:Key="MicButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{Binding MicButtonColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Danger}" />
    </Style>

    <!-- Variantes por intention (UI-4): Biblioteca las necesita todas y hasta ahora
         cada ventana de modulo las reescribia en Window.Resources. Acento = accion
         principal, Exito = va al aire, Aviso = irreversible pero util,
         Peligro = borra. El color nunca es el unico aviso: el texto lo dice tambien. -->
    <Style TargetType="Button" x:Key="AccentButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Info}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="SuccessButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Play}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Success}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAccent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Success}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="WarnButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.OrangeDeep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Orange}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Orange}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Stop}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Danger}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Accent.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Boton de franja de modulos: el borde de acento avisa del modulo ya abierto.
         Estaba solo en MainWindow; aqui queda canonico para que ninguna ventana
         vuelva a declararlo en Window.Resources. -->
    <Style TargetType="Button" x:Key="ModuleStripButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Padding" Value="10,4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="BorderThickness" Value="2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ====================== CAJAS Y CABECERAS ====================== -->
    <Style TargetType="Border" x:Key="Quasar.Card">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Quasar.SectionHeader">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Quasar.Label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>

    <!-- Etiqueta de un campo de formulario (Biblioteca): va encima del control. -->
    <Style TargetType="TextBlock" x:Key="Quasar.FieldLabel" BasedOn="{StaticResource Quasar.Label}">
        <Setter Property="Margin" Value="0,6,0,2" />
    </Style>

    <!-- La misma etiqueta, para formularios de dos columnas (etiqueta | campo). -->
    <Style TargetType="TextBlock" x:Key="Quasar.FieldLabel.Inline" BasedOn="{StaticResource Quasar.Label}">
        <Setter Property="Margin" Value="0,3,8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Boton plano de fila de acciones (Biblioteca): mismo comportamiento, menos alto. -->
    <Style TargetType="Button" x:Key="Quasar.ActionChip" BasedOn="{StaticResource StudioButtonStyle}">
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Cabecera de seccion dentro de una tarjeta de modulo. -->
    <Style TargetType="TextBlock" x:Key="Quasar.CardHeader" BasedOn="{StaticResource Quasar.SectionHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Texto por defecto de la ventana: evita el negro de WPF en temas oscuros -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Deep}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Selection.Deep}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Campo de texto de formulario: rellena su celda y no se come con el borde.
         Va DESPUES del estilo implicito de TextBox y con BasedOn porque, si no, no
         hereda nada: WPF deja de aplicar el estilo implicito en cuanto la vista pide
         uno con x:Key, y el TextBox cae en su plantilla de fabrica (fondo blanco
         SystemColors.Window). Se vio en la captura de Biblioteca del ui4h: los 21
         campos del inspector y de la barra de importacion salian como cajas blancas
         sobre el tema oscuro. Same forward-reference rule as Quasar.Field.Combo. -->
    <Style TargetType="TextBox" x:Key="Quasar.Field" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="Padding" Value="5,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ComboBox: la plantilla por defecto de WPF pinta su propio chrome claro y
         ignora el Background, de modo que el texto seleccionada quedaba ilegible
         sobre tema oscuro. Se plantilla completa. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Shell"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Shell" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
                            <Setter TargetName="Shell" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Chrome" Focusable="False"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Box"
                                            Background="{DynamicResource Brush.Surface.Raised}"
                                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M 0 0 L 8 8 L 16 0 Z"
                                                  Fill="{DynamicResource Brush.Text.Secondary}" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter TargetName="Arrow" Property="Fill" Value="{DynamicResource Brush.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource Brush.Surface.Panel}"
                                    BorderBrush="{DynamicResource Brush.Border.Highlight}"
                                    BorderThickness="1" CornerRadius="0,0,4,4"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Chrome" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- El mismo campo de formulario pero para ComboBox. No puede reutilizarse el de TextBox:
         WPF comprueba el TargetType del Style al aplicarlo y suelta una InvalidOperationException
         ("El TargetType TextBox no coincide con ComboBox") que tumba la construcción de la
         ventana entera. Se descubrio abriendo Biblioteca de verdad, no compilando: el XAML es
         legal y el fallo solo aparece al instanciar la vista. Va despues del estilo implicito
         porque BasedOn con StaticResource solo ve lo declarado mas arriba. -->
    <Style TargetType="ComboBox" x:Key="Quasar.Field.Combo" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Margin" Value="0,2,0,2" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Track}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Deep}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!-- Fila del arbol de categorias de Biblioteca (UI-4): jerarquia por sangria e
         icono, seleccion con el acento del tema. El ancho del contenido tiene que
         estirarse, por eso el HorizontalContentAlignment de arriba. -->
    <Style TargetType="ListBoxItem" x:Key="Quasar.TreeNode" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Height" Value="24" />
        <!-- El nombre accesible lo pone el nodo ("Música, 7 tracks"): sin esto el lector de
             pantalla y los scripts de verificacion solo ven la fila vacia, porque el contenido
             son tres TextBlock sueltos dentro de una plantilla. -->
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Deep}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="Menu">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Raised}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Highlight}" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <!-- ====================== TABLAS ====================== -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="RowBackground" Value="{DynamicResource Brush.Surface.Panel}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource Brush.Surface.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.Border.Subtle}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="RowHeaderWidth" Value="0" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Header}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Header}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,2" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selection.Deep}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Celda de texto de una tabla: se recorta con puntos suspensivos, el tooltip
         deja leer el titulo entero (D3) y el texto se pone en rojo cuando el archivo
         del track no esta (UI-4: el locutor tiene que ver el roto sin abrir nada). -->
    <Style x:Key="Quasar.Cell.Trim" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding FileAvailable}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.DangerSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Igual, para las columnas de tiempo/BPM/prioridad, que van en monoespaciada
         para que las cifras no salten de ancho entre filas. -->
    <Style x:Key="Quasar.Cell.Clock" TargetType="TextBlock" BasedOn="{StaticResource Quasar.Cell.Trim}">
        <Setter Property="FontFamily" Value="{StaticResource Sys.Font.Clock}" />
    </Style>

    <!-- ====================== ARBOL DE CATEGORIAS (Biblioteca, UI-4) ====================== -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style x:Key="Quasar.TreeNodeLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Default}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers>
            <!-- Las lineas de seccion (TIPO DE AUDIO, GÉNERO) no son seleccionables:
                 se leen como etiqueta, no como fila. -->
            <DataTrigger Binding="{Binding IsHeader}" Value="True">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Faint}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Quasar.TreeNodeCount" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Sys.Font.Clock}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ====================== DECKS (identidad A/B, invariante al tema) ====================== -->
    <Style x:Key="DeckGlowBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Default}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.GlowBorder}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="{DynamicResource Color.Glow.A}" />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="{DynamicResource Color.Glow.A}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.Purple}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="{DynamicResource Color.Glow.B}" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeckAActiveChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.DeckA.Chip.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckA.Chip.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DeckA.Chip.ActiveSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckA.Chip.ActiveBorder}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DeckBActiveChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.DeckB.Chip.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckB.Chip.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.DeckB.Chip.ActiveSurface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckB.Chip.ActiveBorder}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
