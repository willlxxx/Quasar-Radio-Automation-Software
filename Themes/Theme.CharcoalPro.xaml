<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ======================================================================
         TEMA · Charcoal Pro
         Gris carbón neutro con ámbar. Sin tinte de color en las superficies:
         es el que mejor engaña al ojo en cabinas con pantalla de referencia
         de vídeo al lado.
         ====================================================================== -->

    <!-- Superficies -->
    <SolidColorBrush x:Key="Brush.Surface.Base" Color="#181818" />
    <SolidColorBrush x:Key="Brush.Surface.Deep" Color="#121212" />
    <SolidColorBrush x:Key="Brush.Surface.Inset" Color="#0D0D0D" />
    <SolidColorBrush x:Key="Brush.Surface.Panel" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Brush.Surface.Card" Color="#242424" />
    <SolidColorBrush x:Key="Brush.Surface.Raised" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Brush.Surface.Header" Color="#282828" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.Surface.Pressed" Color="#151515" />
    <SolidColorBrush x:Key="Brush.Surface.Track" Color="#232323" />
    <SolidColorBrush x:Key="Brush.Surface.GlowBorder" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Brush.Surface.PanelAlt" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Brush.Surface.CardAlt" Color="#262626" />
    <SolidColorBrush x:Key="Brush.Surface.RaisedAlt" Color="#2C2C2C" />
    <SolidColorBrush x:Key="Brush.Surface.BaseAlt" Color="#141414" />
    <SolidColorBrush x:Key="Brush.Surface.FooterButton" Color="#2F2F2F" />
    <SolidColorBrush x:Key="Brush.Surface.DangerSoft" Color="#4A2622" />
    <SolidColorBrush x:Key="Brush.Surface.WarnBadge" Color="#2A2110" />
    <SolidColorBrush x:Key="Brush.Surface.Placeholder" Color="#5C5C5C" />

    <!-- Bordes -->
    <SolidColorBrush x:Key="Brush.Border.Default" Color="#333333" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#3F3F3F" />
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Brush.Border.Highlight" Color="#4D4D4D" />
    <SolidColorBrush x:Key="Brush.Border.Header" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Brush.Border.Alt" Color="#454545" />

    <!-- Texto -->
    <SolidColorBrush x:Key="Brush.Text.High" Color="#FAFAFA" />
    <SolidColorBrush x:Key="Brush.Text.Default" Color="#E4E4E4" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A8A8A8" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Brush.Text.Faint" Color="#8E8E8E" />
    <SolidColorBrush x:Key="Brush.Text.MutedAlt" Color="#9E9E9E" />
    <SolidColorBrush x:Key="Brush.Text.Alt" Color="#C4C4C4" />
    <SolidColorBrush x:Key="Brush.Text.AltHigh" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Brush.Text.OnAccent" Color="#141414" />

    <!-- Acentos -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFB74D" />
    <SolidColorBrush x:Key="Brush.Accent.Success" Color="#81C784" />
    <SolidColorBrush x:Key="Brush.Accent.Play" Color="#66BB6A" />
    <SolidColorBrush x:Key="Brush.Accent.Warn" Color="#FFD54F" />
    <SolidColorBrush x:Key="Brush.Accent.WarnStrong" Color="#FFC107" />
    <SolidColorBrush x:Key="Brush.Accent.Orange" Color="#FF9800" />
    <SolidColorBrush x:Key="Brush.Accent.OrangeDeep" Color="#FB8C00" />
    <SolidColorBrush x:Key="Brush.Accent.Danger" Color="#EF5350" />
    <SolidColorBrush x:Key="Brush.Accent.DangerSoft" Color="#E57373" />
    <SolidColorBrush x:Key="Brush.Accent.Stop" Color="#B71C1C" />
    <SolidColorBrush x:Key="Brush.Accent.Pink" Color="#EC407A" />
    <SolidColorBrush x:Key="Brush.Accent.Info" Color="#4FC3F7" />
    <SolidColorBrush x:Key="Brush.Accent.Cue" Color="#5C6BC0" />
    <SolidColorBrush x:Key="Brush.Accent.CueStrong" Color="#7986CB" />
    <SolidColorBrush x:Key="Brush.Accent.Purple" Color="#B39DDB" />
    <SolidColorBrush x:Key="Brush.Accent.Teal" Color="#26A69A" />
    <SolidColorBrush x:Key="Brush.Accent.Coral" Color="#FF8A65" />
    <SolidColorBrush x:Key="Brush.Selection.Deep" Color="#4E342E" />


    <!-- Colores de resplandor de deck -->
    <Color x:Key="Color.Glow.A">#FFB74D</Color>
    <Color x:Key="Color.Glow.B">#B39DDB</Color>

</ResourceDictionary>
