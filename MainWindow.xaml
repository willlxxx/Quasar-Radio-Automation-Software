<Window x:Class="quasar_radio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:quasar_radio"
        Title="Quasar Radio Pro v3.0 - Suite Radial de Emisión &amp; Automatización" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        local:StudioKeys.CartWall="True"
        Background="{DynamicResource Brush.Surface.Base}" Foreground="{DynamicResource Brush.Text.Default}">

    <!-- F1..F12 -> pads 1..12: ver StudioKeys.cs, declarada igual en cada ventana de modulo. -->

    <Window.Resources>
        <!-- Celda de texto que se recorta con puntos suspensivos y deja leer el titulo
             entero por tooltip (D3: "Sweet child of mine (umba" sin puntos ni tooltip). -->
        <Style x:Key="TrimmingCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>

        <!-- Boton de la franja de modulos (UI-3b). Cada boton pone en Tag su propiedad
             IsXxxOpen: el acento marca la ventana que ya esta abierta, para no abrir dos. -->
        <Style x:Key="ModuleStripButtonStyle" TargetType="Button" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="10,4"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Studio Bar -->
            <RowDefinition Height="Auto" MinHeight="210"/> <!-- Dashboard / Dual Deck A & B Panel: Auto para que el VU master no se recorte (D1) -->
            <RowDefinition Height="*"/>    <!-- Rejilla de Emisión & Tabs -->
            <RowDefinition Height="Auto"/> <!-- Franja de modulos (UI-3b) -->
            <RowDefinition Height="Auto"/> <!-- Status Footer Bar -->
        </Grid.RowDefinitions>

        <!-- ================= PANEL SUPERIOR / HEADER ================= -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" DataContext="{Binding ThemeViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO Y NOMBRE DE LA EMISORA -->
                <Button Grid.Column="0" Command="{Binding ChangeStationLogoCommand}" Background="Transparent" BorderThickness="0" ToolTip="Haz clic para cambiar el logo de la emisora">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding StationLogoPath}" Width="36" Height="36" Margin="0,0,10,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCustomLogo}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Border Width="12" Height="12" CornerRadius="6" Background="{DynamicResource Brush.Accent.Success}" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCustomLogo}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.AudioPlayerViewModel.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource Brush.Surface.Placeholder}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <TextBlock Text="QUASAR RADIO" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" VerticalAlignment="Center"/>
                        <TextBlock Text="PRO v3.0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Info}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- BADGES ESTADO: REPRODUCIENDO / MIC LIVE / STREAM LIVE -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Brush.Accent.Success}" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.AudioPlayerViewModel.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Border.Default}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="REPRODUCIENDO" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    </Border>

                    <Border Background="{DynamicResource Brush.Accent.Danger}" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.AudioPlayerViewModel.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Content="AL AIRE" Background="Transparent" Foreground="{DynamicResource Brush.Text.High}" FontSize="11" FontWeight="Bold" BorderThickness="0" Padding="0"/>
                    </Border>

                    <Border Background="{DynamicResource Brush.Accent.Stop}" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsMicActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="🎤 MIC LIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    </Border>

                    <Border Background="{DynamicResource Brush.Accent}" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.StreamingViewModel.StreamingService.IsStreamingActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="📡 STREAM LIVE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                    </Border>
                </StackPanel>

                <!-- SELECTOR DE TEMAS -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Tema:" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" Width="130" Height="26" FontSize="11" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>

                <!-- BOTÓN ANUNCIAR HORA -->
                <Button Grid.Column="3" Command="{Binding DataContext.AnnounceTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StudioButtonStyle}" Margin="0,0,10,0" Padding="8,4">
                    <TextBlock Text="🕒 HORA" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                </Button>

                <!-- 🎵 LIBRERÍA vivia aqui: desde UI-3b la biblioteca se abre desde la
                     franja de modulos de abajo, con el resto de ventanas. -->

                <!-- CUENTA REGRESIVA PRÓXIMA TANDA -->
                <Border Grid.Column="5" Background="{DynamicResource Brush.Surface.WarnBadge}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" BorderBrush="{DynamicResource Brush.Accent.WarnStrong}" BorderThickness="1">
                    <TextBlock Text="{Binding DataContext.NextCommercialCountdown, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Warn}" VerticalAlignment="Center"/>
                </Border>

                <!-- BOTÓN AUTO / MANUAL -->
                <Button Grid.Column="6" Command="{Binding DataContext.AudioPlayerViewModel.ToggleAutoModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StudioButtonStyle}" Margin="0,0,10,0" Padding="8,4">
                    <TextBlock Text="{Binding DataContext.AudioPlayerViewModel.AutoModeText, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="{Binding DataContext.AudioPlayerViewModel.AutoModeColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Button>

                <!-- RELOJ DIGITAL DE ESTUDIO -->
                <Border Grid.Column="7" Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="6" Padding="12,3" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                    <TextBlock Text="{Binding DataContext.StudioClock, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontFamily="{StaticResource Sys.Font.Clock}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MONITOR PRINCIPAL / DUAL DECK A & B PANEL ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12" DataContext="{Binding AudioPlayerViewModel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/> <!-- Deck A Card -->
                <ColumnDefinition Width="1*"/> <!-- Deck B Card -->
                <ColumnDefinition Width="1.1*"/> <!-- Panel de Control Master & VU Meter -->
            </Grid.ColumnDefinitions>

            <!-- CARD DECK A -->
            <Border Grid.Column="0" Style="{StaticResource DeckGlowBorderStyle}" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Left" Style="{StaticResource DeckAActiveChipStyle}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="DECK A" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource Brush.DeckA.Surface}" BorderBrush="{DynamicResource Brush.DeckA.Border}" BorderThickness="1.5" CornerRadius="6" Padding="8,7" Margin="0,8,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.DeckA.Surface}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckA.Border}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.DeckA.Hover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckA.Border}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource Color.Glow.Card.A}" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                        <Border ClipToBounds="True" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding DeckA_Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.DeckA.Title}" VerticalAlignment="Center" ToolTip="{Binding DeckA_Title}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-220" Duration="0:0:8" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Text="{Binding DeckA_RemainingFormatted}" Foreground="{DynamicResource Brush.Accent.Warn}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource Sys.Font.Clock}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="4" Padding="4,4" Margin="0,0,0,4" BorderBrush="{DynamicResource Brush.Border.Highlight}" BorderThickness="1.2">
                        <local:LedVuMeterControl Value="{Binding DeckA_VuLevel, Mode=OneWay}" SegmentCount="18" Height="20" Width="220"/>
                    </Border>

                    <ProgressBar Grid.Row="3" Value="{Binding DeckA_Progress, Mode=OneWay}" Height="10" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Accent.Success}" BorderThickness="0" Margin="0,4"/>

                    <StackPanel Grid.Row="4" Margin="0,2,0,0">
                        <Border Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="4" Padding="3,2" Margin="0,0,0,2">
                            <Grid Height="24">
                                <ItemsControl ItemsSource="{Binding DeckA_Spectrum}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="18"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24" Margin="1,0">
                                                <Border Background="{DynamicResource Brush.DeckA.Legend}" CornerRadius="2"/>
                                                <Border Height="{Binding}" Background="{DynamicResource Brush.Accent}" VerticalAlignment="Bottom" CornerRadius="2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            <UniformGrid Columns="18" Height="26" Visibility="Collapsed">
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.25" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="6" To="22" Duration="0:0:0.28" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.35" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="10"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="8" To="18" Duration="0:0:0.32" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.45" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="10" To="24" Duration="0:0:0.25" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.6" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="14"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="12" To="26" Duration="0:0:0.23" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.8" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="14" To="28" Duration="0:0:0.2" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="1" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="18"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="16" To="30" Duration="0:0:0.18" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.8" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="14" To="26" Duration="0:0:0.2" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.6" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="14"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="12" To="24" Duration="0:0:0.23" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.45" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="10" To="22" Duration="0:0:0.25" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.35" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="10"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="8" To="18" Duration="0:0:0.32" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.25" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="6" To="18" Duration="0:0:0.35" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </UniformGrid>
                            </Grid>
                        </Border>

                        <ProgressBar Value="{Binding DeckA_VuLevel, Mode=OneWay}" Maximum="100" Height="7" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Accent}" BorderThickness="0" Margin="0,0,0,6" Visibility="Collapsed"/>

                        <UniformGrid Columns="3" Height="28">
                            <Button Command="{Binding DeckAPlayCommand}" Style="{StaticResource PlayButtonStyle}" Margin="0,0,2,0">
                                <TextBlock Text="PLAY" FontWeight="Bold" FontSize="10"/>
                            </Button>
                            <Button Command="{Binding DeckAPauseCommand}" Style="{StaticResource StudioButtonStyle}" Margin="1,0,1,0">
                                <TextBlock Text="PAUSE" FontWeight="Bold" FontSize="10"/>
                            </Button>
                            <Button Command="{Binding DeckACueCommand}" Style="{StaticResource NextButtonStyle}" Margin="2,0,0,0">
                                <TextBlock Text="CUE" FontWeight="Bold" FontSize="10"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CARD DECK B -->
            <Border Grid.Column="1" Style="{StaticResource DeckGlowBorderStyle}" CornerRadius="8" Padding="8" Margin="4,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Left" Style="{StaticResource DeckBActiveChipStyle}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="DECK B" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1" Background="{DynamicResource Brush.DeckB.Surface}" BorderBrush="{DynamicResource Brush.DeckB.Border}" BorderThickness="1.5" CornerRadius="6" Padding="8,7" Margin="0,8,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Brush.DeckB.Surface}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckB.Border}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.DeckB.Hover}"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DeckB.Border}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Effect>
                            <DropShadowEffect Color="{DynamicResource Color.Glow.Card.B}" BlurRadius="14" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                        <Border ClipToBounds="True" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding DeckB_Title}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Brush.DeckB.Title}" VerticalAlignment="Center" ToolTip="{Binding DeckB_Title}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-220" Duration="0:0:8" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Text="{Binding DeckB_RemainingFormatted}" Foreground="{DynamicResource Brush.Accent.Warn}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource Sys.Font.Clock}" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="4" Padding="4,4" Margin="0,0,0,4" BorderBrush="{DynamicResource Brush.Border.Highlight}" BorderThickness="1.2">
                        <local:LedVuMeterControl Value="{Binding DeckB_VuLevel, Mode=OneWay}" SegmentCount="18" Height="20" Width="220"/>
                    </Border>

                    <ProgressBar Grid.Row="3" Value="{Binding DeckB_Progress, Mode=OneWay}" Height="10" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.DeckB.Progress}" BorderThickness="0" Margin="0,4"/>

                    <StackPanel Grid.Row="4" Margin="0,2,0,0">
                        <Border Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="4" Padding="3,2" Margin="0,0,0,2">
                            <Grid Height="24">
                                <ItemsControl ItemsSource="{Binding DeckB_Spectrum}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="18"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24" Margin="1,0">
                                                <Border Background="{DynamicResource Brush.DeckB.Legend}" CornerRadius="2"/>
                                                <Border Height="{Binding}" Background="{DynamicResource Brush.Accent.Purple}" VerticalAlignment="Bottom" CornerRadius="2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            <UniformGrid Columns="18" Height="26" Visibility="Collapsed">
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.25" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="6" To="22" Duration="0:0:0.28" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.35" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="10"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="8" To="20" Duration="0:0:0.31" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.45" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="10" To="24" Duration="0:0:0.24" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.6" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="14"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="12" To="28" Duration="0:0:0.22" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.8" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="14" To="30" Duration="0:0:0.19" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="1" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="18"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="16" To="32" Duration="0:0:0.17" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.8" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="14" To="28" Duration="0:0:0.19" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.6" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="14"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="12" To="26" Duration="0:0:0.22" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.45" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="10" To="24" Duration="0:0:0.24" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.35" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="10"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="8" To="20" Duration="0:0:0.31" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="{DynamicResource Brush.Accent.Purple}" Width="4" RadiusX="2" RadiusY="2" Opacity="0.25" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="6" To="18" Duration="0:0:0.35" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </UniformGrid>
                            </Grid>
                        </Border>

                        <ProgressBar Value="{Binding DeckB_VuLevel, Mode=OneWay}" Maximum="100" Height="7" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Accent.Purple}" BorderThickness="0" Margin="0,0,0,6" Visibility="Collapsed"/>

                        <UniformGrid Columns="3" Height="28">
                            <Button Command="{Binding DeckBPlayCommand}" Style="{StaticResource PlayButtonStyle}" Margin="0,0,2,0">
                                <TextBlock Text="PLAY" FontWeight="Bold" FontSize="10"/>
                            </Button>
                            <Button Command="{Binding DeckBPauseCommand}" Style="{StaticResource StudioButtonStyle}" Margin="1,0,1,0">
                                <TextBlock Text="PAUSE" FontWeight="Bold" FontSize="10"/>
                            </Button>
                            <Button Command="{Binding DeckBCueCommand}" Style="{StaticResource NextButtonStyle}" Margin="2,0,0,0">
                                <TextBlock Text="CUE" FontWeight="Bold" FontSize="10"/>
                            </Button>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- PANEL DE CONTROL MASTER & VUMÉTROS -->
            <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="12" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <UniformGrid Grid.Row="0" Columns="3" Height="40">
                        <Button Command="{Binding PlayCommand}" Style="{StaticResource PlayButtonStyle}" Margin="0,0,3,0">
                            <TextBlock Text="PLAY" FontWeight="Bold"/>
                        </Button>
                        <Button Command="{Binding PauseCommand}" Style="{StaticResource StudioButtonStyle}" Margin="2,0,2,0">
                            <TextBlock Text="PAUSA" FontWeight="Bold"/>
                        </Button>
                        <Button Command="{Binding StopCommand}" Style="{StaticResource StopButtonStyle}" Margin="3,0,0,0">
                            <TextBlock Text="PARAR" FontWeight="Bold"/>
                        </Button>
                    </UniformGrid>

                    <UniformGrid Grid.Row="1" Columns="3" Height="36" Margin="0,6,0,0">
                        <Button Command="{Binding ToggleMicCommand}" Style="{StaticResource MicButtonStyle}" Margin="0,0,2,0">
                            <TextBlock Text="🎤 MIC AL AIRE" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Brush.Text.High}"/>
                        </Button>
                        <Button Command="{Binding NextCommand}" Style="{StaticResource NextButtonStyle}" Margin="2,0,2,0">
                            <TextBlock Text="⏭ CROSSFADE" FontWeight="Bold" FontSize="11"/>
                        </Button>
                        <Button Command="{Binding ToggleSilenceDetectionCommand}" Style="{StaticResource StudioButtonStyle}" Margin="2,0,0,0" Background="{DynamicResource Brush.Button.Mute.Surface}" BorderBrush="{DynamicResource Brush.Button.Mute.Border}">
                            <TextBlock Text="🔇 SILENCIO" FontWeight="Bold" FontSize="11"/>
                        </Button>
                    </UniformGrid>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <!-- VUMÉTROS ESTÉREO BROADCAST -->
                        <TextBlock Text="NIVEL DE SALIDA MASTER (VU METER)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,2"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="L " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="4" Padding="4,4" Margin="0,0,8,0" BorderBrush="{DynamicResource Brush.Border.Highlight}" BorderThickness="1.2">
                                <local:LedVuMeterControl Value="{Binding VuLeftLevel, Mode=OneWay}" SegmentCount="18" Height="20" Width="180"/>
                            </Border>

                            <TextBlock Grid.Column="2" Text="R " FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Background="{DynamicResource Brush.Surface.Inset}" CornerRadius="4" Padding="4,4" BorderBrush="{DynamicResource Brush.Border.Highlight}" BorderThickness="1.2">
                                <local:LedVuMeterControl Value="{Binding VuRightLevel, Mode=OneWay}" SegmentCount="18" Height="20" Width="180"/>
                            </Border>
                        </Grid>

                        <!-- INDICADOR DE DETECCIÓN DE SILENCIO -->
                        <Border Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="4" Padding="8,4" Margin="0,6,0,0" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock Text="🔇 DETECTOR SILENCIO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SilenceDetectionStatusText}" FontSize="10" FontWeight="Bold" Foreground="{Binding SilenceStatusColor}" DockPanel.Dock="Right"/>
                                <ProgressBar Value="{Binding SilenceDetectorLevel, Mode=OneWay}" Maximum="1" Height="4" Background="{DynamicResource Brush.Surface.Track}" Foreground="{Binding SilenceLevelColor}" DockPanel.Dock="Right" Width="60" Margin="0,0,8,0"/>
                            </DockPanel>
                        </Border>

                        <DockPanel Margin="0,4,0,0">
                            <TextBlock Text="VOLUMEN MASTER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                            <TextBlock Text="{Binding VolumePercentageText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Info}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <Slider Value="{Binding MasterVolume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,2,0,0" IsEnabled="{Binding CanOperate}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================= SECCIÓN CENTRAL: REJILLA + PESTAÑAS V3.0 ================= -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.8*"/> <!-- Rejilla de Emisión (Playlist) -->
                <ColumnDefinition Width="1.2*"/> <!-- Pestañas de Suite v3.0 -->
            </Grid.ColumnDefinitions>

            <!-- REJILLA DE EMISIÓN -->
            <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="12" Margin="0,0,8,0" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOOLBAR COMPLETA PLAYLIST V3.0 -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="REJILLA DE EMISIÓN" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                        
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button Command="{Binding LoadFilesCommand}" Style="{StaticResource StudioButtonStyle}" Content="+ Agregar" Margin="0,0,3,0"/>
                            <Button Command="{Binding InsertFilesCommand}" Style="{StaticResource StudioButtonStyle}" Content="+ Insertar" Margin="0,0,3,0"/>
                            <Button Command="{Binding LoadFolderCommand}" Style="{StaticResource StudioButtonStyle}" Content="+ Carpeta" Margin="0,0,3,0"/>
                            <Button Command="{Binding MoveTrackUpCommand}" Style="{StaticResource StudioButtonStyle}" Content="▲" Margin="0,0,3,0"/>
                            <Button Command="{Binding MoveTrackDownCommand}" Style="{StaticResource StudioButtonStyle}" Content="▼" Margin="0,0,3,0"/>
                            <Button Command="{Binding OpenTrackEditorCommand}" Style="{StaticResource StudioButtonStyle}" Content="✎ CUE/BPM" Margin="0,0,3,0"/>
                            <Button Command="{Binding RemoveTrackCommand}" Style="{StaticResource StudioButtonStyle}" Content="✖" Margin="0,0,3,0"/>
                            <Button Command="{Binding ClearPlayedTracksCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑 Emitidos" Margin="0,0,3,0"/>
                            <Button Command="{Binding ClearPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="💥 Vaciar"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- TABLA DATAGRID PROFESIONAL CON DRAG & DROP -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedTrack}"
                              AllowDrop="True" Drop="OnPlaylistDrop"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.Default}" RowBackground="{DynamicResource Brush.Surface.Panel}" 
                              AlternatingRowBackground="{DynamicResource Brush.Surface.Card}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Brush.Border.Subtle}"
                              BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Default}" RowHeight="30" SelectionMode="Single">
                        
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource Brush.Surface.Header}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Header}"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Selection.Deep}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.High}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- BOTÓN PLAY INDIVIDUAL -->
                            <DataGridTemplateColumn Header="Play" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="▶" Command="{Binding DataContext.PlayTrackOnIdleDeckCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="{DynamicResource Brush.Accent.Success}" Foreground="{DynamicResource Brush.Text.High}" FontSize="12" Padding="4" BorderThickness="0" ToolTip="Cargar y reproducir en deck libre"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ICONO Y TIPO DE AUDIO -->
                            <DataGridTextColumn Header="Icon" Binding="{Binding IconSymbol}" Width="35"/>

                            <DataGridTemplateColumn Header="Estado" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource Brush.Text.High}" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Hora Salida" Binding="{Binding EstimatedPlayTimeFormatted}" Width="80" FontFamily="{StaticResource Sys.Font.Clock}"/>
                            <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*" ElementStyle="{StaticResource TrimmingCell}"/>
                            <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="1.5*" ElementStyle="{StaticResource TrimmingCell}"/>
                            <DataGridTextColumn Header="Duración" Binding="{Binding DurationFormatted}" Width="74" FontFamily="{StaticResource Sys.Font.Clock}"/>
                            <DataGridTextColumn Header="Intro" Binding="{Binding IntroSeconds, StringFormat='{}{0:0.0}s'}" Width="50" FontFamily="{StaticResource Sys.Font.Clock}"/>
                            <DataGridTextColumn Header="BPM" Binding="{Binding BpmFormatted}" Width="60"/>
                            <DataGridTextColumn Header="Género" Binding="{Binding Genre}" Width="80" ElementStyle="{StaticResource TrimmingCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- SECCIÓN DERECHA CON PESTAÑAS SUITE V3.0 -->
            <TabControl Grid.Column="1" Background="{DynamicResource Brush.Surface.Card}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Panel}"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="5,5,0,0" Margin="1,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Brush.Surface.Card}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: BASE DE DATOS DE AUDIO CATEGORIZADA -->
                <TabItem Header="BASE DE DATOS">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Categoría:" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding DatabaseService.Categories}" SelectedItem="{Binding DatabaseService.SelectedCategory}" Width="100" FontSize="11" Margin="0,0,8,0"/>

                            <TextBlock Text="Género:" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding DatabaseService.Genres}" SelectedItem="{Binding DatabaseService.SelectedGenre}" Width="100" FontSize="11"/>
                        </DockPanel>

                        <TextBox Grid.Row="1" Text="{Binding DatabaseService.SearchText, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="4" Margin="0,0,0,6"/>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding DatabaseService.FilteredTracks}" SelectedItem="{Binding SelectedDbTrack}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.Default}" RowBackground="{DynamicResource Brush.Surface.Panel}" 
                                  AlternatingRowBackground="{DynamicResource Brush.Surface.Card}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Brush.Border.Subtle}"
                                  BorderThickness="1" BorderBrush="{DynamicResource Brush.Border.Default}" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Icon" Binding="{Binding IconSymbol}" Width="35"/>
                                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*" ElementStyle="{StaticResource TrimmingCell}"/>
                                <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="1.5*" ElementStyle="{StaticResource TrimmingCell}"/>
                                <DataGridTextColumn Header="Duración" Binding="{Binding DurationFormatted}" Width="74" FontFamily="{StaticResource Sys.Font.Clock}"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- D3: UniformGrid recortaba "AUTO PLAYLI"/"LIMPIAR HIS" porque el
                             ancho de celda dependia de la ventana. Con WrapPanel el boton
                             conserva su ancho y la fila que sobre baja sola. -->
                        <WrapPanel Grid.Row="3" Margin="0,2,0,0">
                            <Button Command="{Binding AddTrackFromDbToPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="+ Encolar" Width="152" Height="30" FontSize="11" Padding="4,0" Margin="0,0,4,4"/>
                            <Button Command="{Binding PlayAux1Command}" Style="{StaticResource StudioButtonStyle}" Content="▶ PFL AUX 1" Width="152" Height="30" FontSize="11" Padding="4,0" Margin="0,0,4,4"/>
                            <Button Command="{Binding GenerateAutoPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="⚡ AUTO PLAYLIST" Width="152" Height="30" FontSize="11" Padding="4,0" Margin="0,0,4,4"/>
                            <Button Command="{Binding GenerateSmartPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="🧠 SMART PLAYLIST" Width="152" Height="30" FontSize="11" Padding="4,0" Margin="0,0,4,4" Background="{DynamicResource Brush.Accent.Info}" BorderBrush="{DynamicResource Brush.Accent}"/>
                            <Button Command="{Binding ClearRotationHistoryCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑️ LIMPIAR HISTORIAL" Width="152" Height="30" FontSize="10" Padding="4,0" Margin="0,0,4,4" Background="{DynamicResource Brush.Accent.OrangeDeep}" BorderBrush="{DynamicResource Brush.Accent.Orange}"/>
                        </WrapPanel>
                    </Grid>
                </TabItem>

                <!-- TAB 2: PROCESADOR DE SONIDO DSP -->
                <TabItem Header="PROCESADOR DSP" IsEnabled="{Binding IsAdmin}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <Border Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox Content="CONTROL AUTOMÁTICO DE GANANCIA (AGC)"
                                              IsChecked="{Binding DspProcessor.IsAgcEnabled}"
                                              Foreground="{DynamicResource Brush.Accent}" FontWeight="Bold" FontSize="10"/>
                                    <DockPanel Margin="0,5,0,0">
                                        <TextBlock Text="Nivel objetivo" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                        <TextBlock Text="{Binding DspProcessor.AgcTargetDb, StringFormat='{}{0:0} dB'}" FontSize="10" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Value="{Binding DspProcessor.AgcTargetDb}" Minimum="-30" Maximum="-6" IsEnabled="{Binding DspProcessor.IsAgcEnabled}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ECUALIZADOR GRÁFICO 10 BANDAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Preset EQ:" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <ComboBox ItemsSource="{Binding DspProcessor.EqPresets}" SelectedItem="{Binding DspProcessor.SelectedEqPreset}" Width="160" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <UniformGrid Columns="10" Margin="0,0,0,10">
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="31Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band31Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band31Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="62Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band62Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band62Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="125Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band125Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band125Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="250Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band250Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band250Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="500Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band500Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band500Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="1kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band1kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band1kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="2kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band2kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band2kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="4kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band4kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band4kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="8kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band8kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band8kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="16kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band16kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band16kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                            </UniformGrid>

                            <Separator Background="{DynamicResource Brush.Border.Default}" Margin="0,4,0,8"/>

                            <TextBlock Text="COMPRESOR / LIMITADOR BROADCAST" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Preset Comp:" FontSize="11" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <ComboBox ItemsSource="{Binding DspProcessor.CompressorPresets}" SelectedItem="{Binding DspProcessor.SelectedCompPreset}" Width="160" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Margin="0,4"><TextBlock Text="Threshold (Umbral):" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}"/><TextBlock Text="{Binding DspProcessor.CompThreshold, StringFormat='{}{0:0}dB'}" FontSize="10" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Right"/></DockPanel>
                            <Slider Value="{Binding DspProcessor.CompThreshold}" Minimum="-36" Maximum="0"/>

                            <DockPanel Margin="0,4"><TextBlock Text="Ratio (Proporción):" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}"/><TextBlock Text="{Binding DspProcessor.CompRatio, StringFormat='{}{0:0.0}:1'}" FontSize="10" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Right"/></DockPanel>
                            <Slider Value="{Binding DspProcessor.CompRatio}" Minimum="1" Maximum="10"/>

                            <DockPanel Margin="0,4"><TextBlock Text="Makeup Gain (Ganancia):" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}"/><TextBlock Text="{Binding DspProcessor.CompMakeup, StringFormat='{}{0:0}dB'}" FontSize="10" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Right"/></DockPanel>
                            <Slider Value="{Binding DspProcessor.CompMakeup}" Minimum="0" Maximum="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: CARTWALL SFX -->
                <TabItem Header="CARTWALL (SFX)">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="BOTONERA DE EFECTOS [F1-F12]" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Command="{Binding StopAllCartPadsCommand}" Style="{StaticResource StudioButtonStyle}" Padding="6,3" FontSize="10" Content="⏹ PARAR SFX" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CartPads}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" CornerRadius="5" Background="{DynamicResource Brush.Surface.Panel}" BorderBrush="{Binding StatusBorderColor}" BorderThickness="2">
                                        <Button Command="{Binding DataContext.TriggerCartPadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="3">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Asignar Audio..." Command="{Binding DataContext.AssignCartPadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Vaciar Pad" Command="{Binding DataContext.ClearCartPadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <Border Background="{Binding ColorHex}" CornerRadius="3" Padding="3,1" HorizontalAlignment="Left" DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding ShortcutText}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.OnAccent}"/>
                                                    </Border>
                                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Brush.Accent.Success}" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </DockPanel>

                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" 
                                                           Foreground="{DynamicResource Brush.Text.High}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <DockPanel>
                                <TextBlock Text="VOLUMEN CARTWALL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding CartwallVolumePercentageText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Value="{Binding CartwallMasterVolume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,2,0,0" IsEnabled="{Binding CanOperate}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- TAB 4: REPRODUCTORES AUXILIARES PFL -->
                <TabItem Header="AUX PFL" IsEnabled="{Binding CanOperate}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- AUX 1 -->
                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="6" Padding="10" Margin="0,0,0,6" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="REPRODUCTOR AUXILIAR 1 (PFL CUE)" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" FontSize="11" DockPanel.Dock="Left"/>
                                    <Button Command="{Binding AuxPlayers.Aux1.Stop}" Style="{StaticResource StudioButtonStyle}" Padding="6,2" FontSize="9" Content="⏹ PARAR AUX 1" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <TextBlock Text="{Binding AuxPlayers.Aux1.CurrentTrack.Title, FallbackValue='NINGUN AUDIO EN AUX 1'}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" FontSize="12"/>
                                <TextBlock Text="{Binding AuxPlayers.Aux1.CurrentTrack.Artist, FallbackValue='Monitoreo privado sin salida al aire'}" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,6"/>

                                <DockPanel>
                                    <TextBlock Text="VOLUMEN AUX 1" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                    <Slider Value="{Binding AuxPlayers.Aux1.Volume}" Minimum="0" Maximum="1" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- AUX 2 -->
                        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="6" Padding="10" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="REPRODUCTOR AUXILIAR 2 (PFL CUE)" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Warn}" FontSize="11" DockPanel.Dock="Left"/>
                                    <Button Command="{Binding AuxPlayers.Aux2.Stop}" Style="{StaticResource StudioButtonStyle}" Padding="6,2" FontSize="9" Content="⏹ PARAR AUX 2" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <TextBlock Text="{Binding AuxPlayers.Aux2.CurrentTrack.Title, FallbackValue='NINGUN AUDIO EN AUX 2'}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" FontSize="12"/>
                                <TextBlock Text="{Binding AuxPlayers.Aux2.CurrentTrack.Artist, FallbackValue='Monitoreo privado sin salida al aire'}" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,6"/>

                                <DockPanel>
                                    <TextBlock Text="VOLUMEN AUX 2" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                    <Slider Value="{Binding AuxPlayers.Aux2.Volume}" Minimum="0" Maximum="1" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 5: TANDAS COMERCIALES -->
                <TabItem Header="TANDAS">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PAUTAS Y TANDAS PROGRAMADAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Orange}" Margin="0,0,0,6"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding CommercialBlocks}" Background="{DynamicResource Brush.Surface.Deep}" BorderBrush="{DynamicResource Brush.Border.Subtle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Surface.Card}" CornerRadius="5" Padding="8" Margin="0,3" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" FontSize="13" DockPanel.Dock="Left"/>
                                                <Button Content="📢 LANZAR AHORA" 
                                                        Command="{Binding DataContext.TriggerCommercialBlockNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CommercialButtonStyle}" 
                                                        Padding="6,3" FontSize="9" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <DockPanel Grid.Row="1" Margin="0,3">
                                                <TextBlock Text="{Binding ScheduleText}" Foreground="{DynamicResource Brush.Accent.Warn}" FontSize="10" FontFamily="{StaticResource Sys.Font.Clock}" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding TotalDurationFormatted, StringFormat='Duración: {0}'}" Foreground="{DynamicResource Brush.Text.Secondary}" FontSize="10" DockPanel.Dock="Right"/>
                                            </DockPanel>

                                            <DockPanel Grid.Row="2" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Spots.Count, StringFormat='Cuñas: {0}'}" Foreground="{DynamicResource Brush.Accent.Success}" FontSize="10" DockPanel.Dock="Left"/>
                                                <Button Content="+ Agregar Spot" 
                                                        Command="{Binding DataContext.AddSpotToBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StudioButtonStyle}" Padding="5,2" FontSize="9" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- TAB 6: STREAMING & METADATA -->
                <TabItem Header="STREAMING">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- STREAMING CONTROL -->
                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="{Binding StreamingService.StatusColor}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding StreamingService.StreamingStatusText}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Command="{Binding TestIcecastConnectionCommand}" Style="{StaticResource StudioButtonStyle}" Content="🔍 PROBAR" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <Button Command="{Binding ToggleStreamingCommand}" Style="{StaticResource StudioButtonStyle}" Content="{Binding StreamingService.StreamingButtonText}" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding StreamingService.StatusMessage}" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Servidor:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.ServerUrl, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="150" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Puerto:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.ServerPort, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="60" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Mountpoint:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.MountPoint, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="120" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Password:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.Password, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Accent.Warn}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="100" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="FFmpeg:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.FFmpegPath, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="120" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="ESTADÍSTICAS DE STREAMING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Conexión:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding StreamingService.ConnectionTimeFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Duración:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding StreamingService.StreamDurationFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Datos enviados:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding StreamingService.BytesSentFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Bitrate:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding StreamingService.Bitrate, StringFormat='{}{0} kbps'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Circuit breaker:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding StreamingService.CircuitBreakerState}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Paquetes descartados:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding StreamingService.BufferOverrunCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Orange}"/>
                                    <TextBlock Text="Silencios por underrun:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding StreamingService.BufferUnderrunCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Warn}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- NOW PLAYING METADATA -->
                        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="EXPORTACIÓN NOWPLAYING (RDS / TXT / JSON)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,6"/>

                                <TextBlock Text="Tema al Aire Actual:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                <Border Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="4" Padding="6" Margin="0,2,0,6" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                                    <TextBlock Text="{Binding CurrentNowPlayingText}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Warn}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <TextBlock Text="Archivos exportados:" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                                <TextBlock Text="• nowplaying.txt (RDS / Transmisor / OBS)" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}"/>
                                <TextBlock Text="• nowplaying.json (Web App HTML5)" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 7: GRABACIÓN DE EMISIONES -->
                <TabItem Header="GRABACIÓN">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CONTROL DE GRABACIÓN -->
                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="{Binding RecordingService.StatusColor}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding RecordingService.RecordingStatusText}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Danger}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Command="{Binding ToggleRecordingCommand}" Style="{StaticResource StudioButtonStyle}" Content="{Binding RecordingService.RecordingButtonText}" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource Brush.Accent.Danger}" BorderBrush="{DynamicResource Brush.Accent.DangerSoft}"/>
                                    </DockPanel>

                                    <TextBlock Text="Grabando audio del sistema (loopback)" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Archivo:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding RecordingService.CurrentFileName}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" FontSize="10" DockPanel.Dock="Right"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Carpeta:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding RecordingService.RecordingFolder}" FontSize="10" Foreground="{DynamicResource Brush.Text.High}" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="ESTADÍSTICAS DE GRABACIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Inicio:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding RecordingService.RecordingStartTimeFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Duración:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding RecordingService.RecordingDurationFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4"/>

                                    <TextBlock Text="Tamaño:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding RecordingService.BytesRecordedFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CONTROLES DE ARCHIVOS -->
                        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <UniformGrid Columns="2">
                                <Button Command="{Binding OpenRecordingFolderCommand}" Style="{StaticResource StudioButtonStyle}" Content="📁 ABRIR CARPETA" Margin="0,0,4,0"/>
                                <Button Command="{Binding DeleteRecordingCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑️ ELIMINAR SELECCIONADO" Margin="4,0,0,0" Background="{DynamicResource Brush.Accent.OrangeDeep}" BorderBrush="{DynamicResource Brush.Accent.Orange}"/>
                            </UniformGrid>
                        </Border>

                        <!-- LISTA DE GRABACIONES -->
                        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ARCHIVOS DE GRABACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,6"/>
                                <TextBlock Text="Las grabaciones se guardan en formato WAV de alta calidad (44.1kHz, 16-bit, estéreo)" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBlock Text="Ubicación: grabaciones/ (en el directorio del proyecto)" FontSize="9" Foreground="{DynamicResource Brush.Accent.Warn}" Margin="0,0,0,6"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 8: ESTADÍSTICAS -->
                <TabItem Header="ESTADÍSTICAS">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- RESUMEN GENERAL -->
                        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="TRACKS EN SESIÓN" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.SessionTrackCount}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" FontFamily="{StaticResource Sys.Font.Clock}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="TIEMPO TOTAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.TotalSessionPlayTime, StringFormat='{}{0:hh\\:mm\\:ss}'}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" FontFamily="{StaticResource Sys.Font.Clock}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="TRACKS ÚNICOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.TotalUniqueTracks}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" FontFamily="{StaticResource Sys.Font.Clock}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="REGISTROS TOTALES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.TotalPlaybackRecords}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" FontFamily="{StaticResource Sys.Font.Clock}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CONTROLES DE ESTADÍSTICAS -->
                        <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <WrapPanel HorizontalAlignment="Center">
                                <Button Command="{Binding GenerateStatisticsReportCommand}" Style="{StaticResource StudioButtonStyle}" Content="📊 GENERAR REPORTE" Width="246" Height="30" FontSize="11" Padding="4,0" Margin="0,0,4,0" Background="{DynamicResource Brush.Accent.Info}" BorderBrush="{DynamicResource Brush.Accent}"/>
                                <Button Command="{Binding SaveStatisticsCommand}" Style="{StaticResource StudioButtonStyle}" Content="💾 GUARDAR" Width="246" Height="30" FontSize="11" Padding="4,0" Margin="0,0,4,0"/>
                                <Button Command="{Binding LoadStatisticsCommand}" Style="{StaticResource StudioButtonStyle}" Content="📂 CARGAR" Width="246" Height="30" FontSize="11" Padding="4,0"/>
                                <Button Command="{Binding ClearStatisticsCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑️ LIMPIAR" Width="246" Height="30" FontSize="11" Padding="4,0" Margin="0,0,4,0" Background="{DynamicResource Brush.Accent.OrangeDeep}" BorderBrush="{DynamicResource Brush.Accent.Orange}"/>
                            </WrapPanel>
                        </Border>

                        <!-- INFORMACIÓN -->
                        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SISTEMA DE ESTADÍSTICAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,6"/>
                                <TextBlock Text="El sistema registra automáticamente cada reproducción con información detallada:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>
                                <TextBlock Text="• Tracks más populares por número de reproducciones" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,2"/>
                                <TextBlock Text="• Tiempo total de reproducción por track" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,2"/>
                                <TextBlock Text="• Estadísticas por hora del día" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,2"/>
                                <TextBlock Text="• Estadísticas por género musical" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,2"/>
                                <TextBlock Text="• Historial de reproducciones diario" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,2"/>
                                <TextBlock Text="• Reportes exportables en formato texto" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,6"/>
                                <TextBlock Text="Los datos se guardan en formato JSON para persistencia entre sesiones." FontSize="9" Foreground="{DynamicResource Brush.Accent.Warn}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ================= FRANJA DE MODULOS (UI-3b) =================
             Lo que eran las pestañas de la suite: cada una es ahora su propia ventana,
             abierta por IModuleNavigator. El borde de acento avisa de la que ya está
             abierta para no duplicarla. -->
        <Border Grid.Row="3" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="5" Padding="10,6" Margin="0,8,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MÓDULOS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <Button Style="{StaticResource ModuleStripButtonStyle}" Command="{Binding OpenModuleCommand}" CommandParameter="Library" Tag="{Binding IsLibraryOpen}" ToolTip="Biblioteca de medios (admin)">
                        <TextBlock Text="🎵 BIBLIOTECA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    </Button>
                    <Button Style="{StaticResource ModuleStripButtonStyle}" Command="{Binding OpenModuleCommand}" CommandParameter="Schedule" Tag="{Binding IsScheduleOpen}" ToolTip="Tandas y programación horaria">
                        <TextBlock Text="🗓 PROGRAMACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    </Button>
                    <Button Style="{StaticResource ModuleStripButtonStyle}" Command="{Binding OpenModuleCommand}" CommandParameter="Dsp" Tag="{Binding IsDspOpen}" ToolTip="Procesador DSP y AUX PFL (admin)">
                        <TextBlock Text="🎛 DSP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    </Button>
                    <Button Style="{StaticResource ModuleStripButtonStyle}" Command="{Binding OpenModuleCommand}" CommandParameter="Streaming" Tag="{Binding IsStreamingOpen}" ToolTip="Streaming Icecast y grabación">
                        <TextBlock Text="📡 STREAMING" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    </Button>
                    <Button Style="{StaticResource ModuleStripButtonStyle}" Command="{Binding OpenModuleCommand}" CommandParameter="Reports" Tag="{Binding IsReportsOpen}" ToolTip="Estadísticas y reportes de emisión">
                        <TextBlock Text="📊 REPORTES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="Cada módulo abre su propia ventana · cerrar un módulo no cierra la emisora"
                           FontSize="9" Foreground="{DynamicResource Brush.Text.Faint}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <!-- ================= STATUS FOOTER BAR ================= -->
        <Border Grid.Row="4" Background="{DynamicResource Brush.Surface.Panel}" CornerRadius="4" Padding="10,5" Margin="0,8,0,0" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
            <!-- El DockPanel con LastChildFill por defecto hacia que el bloque de la derecha
                 ocupara lo que dejaba el estado y lo pegara al "Invitado" (D3). -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{DynamicResource Brush.Accent.Success}" FontSize="11" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="CurrentUserText" Foreground="{DynamicResource Brush.Text.Muted}" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ManageUsersButton" Content="USUARIOS" Click="OnManageUsersClick" Background="{DynamicResource Brush.Surface.FooterButton}" Foreground="{DynamicResource Brush.Text.High}" BorderThickness="0" Padding="8,3" Margin="0,0,6,0"/>
                    <Button Content="CERRAR SESIÓN" Click="OnLogoutClick" Background="{DynamicResource Brush.Surface.DangerSoft}" Foreground="{DynamicResource Brush.Text.High}" BorderThickness="0" Padding="8,3" Margin="0,0,12,0"/>
                    <TextBlock Text="Quasar Radio Pro v3.0" Foreground="{DynamicResource Brush.Text.Faint}" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
