                            <Button Command="{Binding InsertFilesCommand}" Style="{StaticResource StudioButtonStyle}" Content="+ Insertar" Margin="0,0,3,0"/>
                            <Button Command="{Binding LoadFolderCommand}" Style="{StaticResource StudioButtonStyle}" Content="+ Carpeta" Margin="0,0,3,0"/>
                            <Button Command="{Binding MoveTrackUpCommand}" Style="{StaticResource StudioButtonStyle}" Content="▲" Margin="0,0,3,0"/>
                            <Button Command="{Binding MoveTrackDownCommand}" Style="{StaticResource StudioButtonStyle}" Content="▼" Margin="0,0,3,0"/>
                            <Button Command="{Binding OpenTrackEditorCommand}" Style="{StaticResource StudioButtonStyle}" Content="✎ CUE/BPM" Margin="0,0,3,0"/>
                            <Button Command="{Binding RemoveTrackCommand}" Style="{StaticResource StudioButtonStyle}" Content="✖" Margin="0,0,3,0"/>
                            <Button Command="{Binding ClearPlayedTracksCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑 Emitidos" Margin="0,0,3,0"/>
                            <Button Command="{Binding ClearPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="💥 Vaciar"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- TABLA DATAGRID PROFESIONAL CON DRAG & DROP -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Playlist}" SelectedItem="{Binding SelectedTrack}"
                              AllowDrop="True" Drop="OnPlaylistDrop"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#0B0D14" Foreground="#E0E6ED" RowBackground="#11141F" 
                              AlternatingRowBackground="#161B26" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2636"
                              BorderThickness="1" BorderBrush="#262D3D" RowHeight="30" SelectionMode="Single">
                        
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A202C"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="28"/>
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#2D3748"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#005599"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <!-- BOTÓN PLAY INDIVIDUAL -->
                            <DataGridTemplateColumn Header="Play" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="▶" Command="{Binding DataContext.PlayTrackOnIdleDeckCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Background="#00E676" Foreground="#FFFFFF" FontSize="12" Padding="4" BorderThickness="0" ToolTip="Cargar y reproducir en deck libre"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- ICONO Y TIPO DE AUDIO -->
                            <DataGridTextColumn Header="Icon" Binding="{Binding IconSymbol}" Width="35"/>

                            <DataGridTemplateColumn Header="Estado" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="4,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusText}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Hora Salida" Binding="{Binding EstimatedPlayTimeFormatted}" Width="80" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="1.5*"/>
                            <DataGridTextColumn Header="Duración" Binding="{Binding DurationFormatted}" Width="60" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Intro" Binding="{Binding IntroSeconds, StringFormat='{}{0:0.0}s'}" Width="50" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="BPM" Binding="{Binding BpmFormatted}" Width="60"/>
                            <DataGridTextColumn Header="Género" Binding="{Binding Genre}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- SECCIÓN DERECHA CON PESTAÑAS SUITE V3.0 -->
            <TabControl Grid.Column="1" Background="{Binding CardBackground}" BorderBrush="#262D3D" BorderThickness="1">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#11141F"/>
                        <Setter Property="Foreground" Value="#A0AEC0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="5,5,0,0" Margin="1,0" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#161B26"/>
                                            <Setter Property="Foreground" Value="#00E5FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- TAB 1: BASE DE DATOS DE AUDIO CATEGORIZADA -->
                <TabItem Header="BASE DE DATOS">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="Categoría:" FontSize="11" Foreground="#8A99AD" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding DatabaseService.Categories}" SelectedItem="{Binding DatabaseService.SelectedCategory}" Width="100" FontSize="11" Margin="0,0,8,0"/>

                            <TextBlock Text="Género:" FontSize="11" Foreground="#8A99AD" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding DatabaseService.Genres}" SelectedItem="{Binding DatabaseService.SelectedGenre}" Width="100" FontSize="11"/>
                        </DockPanel>

                        <TextBox Grid.Row="1" Text="{Binding DatabaseService.SearchText, UpdateSourceTrigger=PropertyChanged}" Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#262D3D" Padding="4" Margin="0,0,0,6"/>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding DatabaseService.FilteredTracks}" SelectedItem="{Binding SelectedDbTrack}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                  Background="#0B0D14" Foreground="#E0E6ED" RowBackground="#11141F" 
                                  AlternatingRowBackground="#161B26" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2636"
                                  BorderThickness="1" BorderBrush="#262D3D" RowHeight="26">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Icon" Binding="{Binding IconSymbol}" Width="35"/>
                                <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*"/>
                                <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="1.5*"/>
                                <DataGridTextColumn Header="Duración" Binding="{Binding DurationFormatted}" Width="65" FontFamily="Consolas"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <UniformGrid Grid.Row="3" Columns="5" Margin="0,6,0,0">
                            <Button Command="{Binding AddTrackFromDbToPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="+ Encolar" Margin="0,0,2,0"/>
                            <Button Command="{Binding PlayAux1Command}" Style="{StaticResource StudioButtonStyle}" Content="▶ PFL AUX 1" Margin="2,0,2,0"/>
                            <Button Command="{Binding GenerateAutoPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="⚡ AUTO PLAYLIST" Margin="2,0,2,0"/>
                            <Button Command="{Binding GenerateSmartPlaylistCommand}" Style="{StaticResource StudioButtonStyle}" Content="🧠 SMART PLAYLIST" Margin="2,0,2,0" Background="#00B0FF" BorderBrush="#00E5FF"/>
                            <Button Command="{Binding ClearRotationHistoryCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑️ LIMPIAR HISTORIAL" Margin="2,0,0,0" Background="#FF6D00" BorderBrush="#FF9100"/>
                        </UniformGrid>
                    </Grid>
                </TabItem>

                <!-- TAB 2: PROCESADOR DE SONIDO DSP -->
                <TabItem Header="PROCESADOR DSP" IsEnabled="{Binding IsAdmin}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8">
                            <Border Background="#11141F" BorderBrush="#262D3D" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                <StackPanel>
                                    <CheckBox Content="CONTROL AUTOMÁTICO DE GANANCIA (AGC)"
                                              IsChecked="{Binding DspProcessor.IsAgcEnabled}"
                                              Foreground="#00E5FF" FontWeight="Bold" FontSize="10"/>
                                    <DockPanel Margin="0,5,0,0">
                                        <TextBlock Text="Nivel objetivo" FontSize="10" Foreground="#8A99AD"/>
                                        <TextBlock Text="{Binding DspProcessor.AgcTargetDb, StringFormat='{}{0:0} dB'}" FontSize="10" Foreground="#00E5FF" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                    <Slider Value="{Binding DspProcessor.AgcTargetDb}" Minimum="-30" Maximum="-6" IsEnabled="{Binding DspProcessor.IsAgcEnabled}"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Text="ECUALIZADOR GRÁFICO 10 BANDAS" FontSize="11" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Preset EQ:" FontSize="11" Foreground="#8A99AD" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <ComboBox ItemsSource="{Binding DspProcessor.EqPresets}" SelectedItem="{Binding DspProcessor.SelectedEqPreset}" Width="160" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <UniformGrid Columns="10" Margin="0,0,0,10">
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="31Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band31Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band31Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="62Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band62Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band62Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="125Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band125Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band125Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="250Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band250Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band250Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="500Hz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band500Hz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band500Hz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="1kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band1kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band1kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="2kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band2kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band2kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="4kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band4kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band4kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="8kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band8kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band8kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                                <StackPanel Margin="1,2,1,0"><TextBlock Text="16kHz" FontSize="9" HorizontalAlignment="Center"/><Slider Value="{Binding DspProcessor.Band16kHz}" Minimum="-12" Maximum="12" Orientation="Vertical" Width="22" Height="120" HorizontalAlignment="Center"/><TextBlock Text="{Binding DspProcessor.Band16kHz, StringFormat='{}{0:0}dB'}" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
                            </UniformGrid>

                            <Separator Background="#262D3D" Margin="0,4,0,8"/>

                            <TextBlock Text="COMPRESOR / LIMITADOR BROADCAST" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,6"/>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Preset Comp:" FontSize="11" Foreground="#8A99AD" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <ComboBox ItemsSource="{Binding DspProcessor.CompressorPresets}" SelectedItem="{Binding DspProcessor.SelectedCompPreset}" Width="160" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <DockPanel Margin="0,4"><TextBlock Text="Threshold (Umbral):" FontSize="10" Foreground="#8A99AD"/><TextBlock Text="{Binding DspProcessor.CompThreshold, StringFormat='{}{0:0}dB'}" FontSize="10" Foreground="#00E5FF" DockPanel.Dock="Right"/></DockPanel>
                            <Slider Value="{Binding DspProcessor.CompThreshold}" Minimum="-36" Maximum="0"/>

                            <DockPanel Margin="0,4"><TextBlock Text="Ratio (Proporción):" FontSize="10" Foreground="#8A99AD"/><TextBlock Text="{Binding DspProcessor.CompRatio, StringFormat='{}{0:0.0}:1'}" FontSize="10" Foreground="#00E5FF" DockPanel.Dock="Right"/></DockPanel>
                            <Slider Value="{Binding DspProcessor.CompRatio}" Minimum="1" Maximum="10"/>

                            <DockPanel Margin="0,4"><TextBlock Text="Makeup Gain (Ganancia):" FontSize="10" Foreground="#8A99AD"/><TextBlock Text="{Binding DspProcessor.CompMakeup, StringFormat='{}{0:0}dB'}" FontSize="10" Foreground="#00E5FF" DockPanel.Dock="Right"/></DockPanel>
                            <Slider Value="{Binding DspProcessor.CompMakeup}" Minimum="0" Maximum="12"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- TAB 3: CARTWALL SFX -->
                <TabItem Header="CARTWALL (SFX)">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="BOTONERA DE EFECTOS [F1-F12]" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <Button Command="{Binding StopAllCartPadsCommand}" Style="{StaticResource StudioButtonStyle}" Padding="6,3" FontSize="10" Content="⏹ PARAR SFX" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding CartPads}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="2" CornerRadius="5" Background="#11141F" BorderBrush="{Binding StatusBorderColor}" BorderThickness="2">
                                        <Button Command="{Binding DataContext.TriggerCartPadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0" Padding="3">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Asignar Audio..." Command="{Binding DataContext.AssignCartPadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                    <MenuItem Header="Vaciar Pad" Command="{Binding DataContext.ClearCartPadCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>

                                                <DockPanel Grid.Row="0">
                                                    <Border Background="{Binding ColorHex}" CornerRadius="3" Padding="3,1" HorizontalAlignment="Left" DockPanel.Dock="Left">
                                                        <TextBlock Text="{Binding ShortcutText}" FontSize="9" FontWeight="Bold" Foreground="#000000"/>
                                                    </Border>
                                                    <Ellipse Width="7" Height="7" Fill="#00E676" HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                </DockPanel>

                                                <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="10" FontWeight="SemiBold" 
                                                           Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>
                                            </Grid>
                                        </Button>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2" Margin="0,6,0,0">
                            <DockPanel>
                                <TextBlock Text="VOLUMEN CARTWALL" FontSize="10" FontWeight="Bold" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding CartwallVolumePercentageText}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <Slider Value="{Binding CartwallMasterVolume}" Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Margin="0,2,0,0" IsEnabled="{Binding CanOperate}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- TAB 4: REPRODUCTORES AUXILIARES PFL -->
                <TabItem Header="AUX PFL" IsEnabled="{Binding CanOperate}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>

                        <!-- AUX 1 -->
                        <Border Grid.Row="0" Background="#11141F" CornerRadius="6" Padding="10" Margin="0,0,0,6" BorderBrush="#262D3D" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="REPRODUCTOR AUXILIAR 1 (PFL CUE)" FontWeight="Bold" Foreground="#00E5FF" FontSize="11" DockPanel.Dock="Left"/>
                                    <Button Command="{Binding AuxPlayers.Aux1.Stop}" Style="{StaticResource StudioButtonStyle}" Padding="6,2" FontSize="9" Content="⏹ PARAR AUX 1" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <TextBlock Text="{Binding AuxPlayers.Aux1.CurrentTrack.Title, FallbackValue='NINGUN AUDIO EN AUX 1'}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                <TextBlock Text="{Binding AuxPlayers.Aux1.CurrentTrack.Artist, FallbackValue='Monitoreo privado sin salida al aire'}" FontSize="10" Foreground="#8A99AD" Margin="0,2,0,6"/>

                                <DockPanel>
                                    <TextBlock Text="VOLUMEN AUX 1" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                    <Slider Value="{Binding AuxPlayers.Aux1.Volume}" Minimum="0" Maximum="1" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <!-- AUX 2 -->
                        <Border Grid.Row="1" Background="#11141F" CornerRadius="6" Padding="10" BorderBrush="#262D3D" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="REPRODUCTOR AUXILIAR 2 (PFL CUE)" FontWeight="Bold" Foreground="#FFEA00" FontSize="11" DockPanel.Dock="Left"/>
                                    <Button Command="{Binding AuxPlayers.Aux2.Stop}" Style="{StaticResource StudioButtonStyle}" Padding="6,2" FontSize="9" Content="⏹ PARAR AUX 2" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>

                                <TextBlock Text="{Binding AuxPlayers.Aux2.CurrentTrack.Title, FallbackValue='NINGUN AUDIO EN AUX 2'}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                <TextBlock Text="{Binding AuxPlayers.Aux2.CurrentTrack.Artist, FallbackValue='Monitoreo privado sin salida al aire'}" FontSize="10" Foreground="#8A99AD" Margin="0,2,0,6"/>

                                <DockPanel>
                                    <TextBlock Text="VOLUMEN AUX 2" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                    <Slider Value="{Binding AuxPlayers.Aux2.Volume}" Minimum="0" Maximum="1" Margin="8,0,0,0"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 5: TANDAS COMERCIALES -->
                <TabItem Header="TANDAS">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PAUTAS Y TANDAS PROGRAMADAS" FontSize="11" FontWeight="Bold" Foreground="#FF9100" Margin="0,0,0,6"/>

                        <ListBox Grid.Row="1" ItemsSource="{Binding CommercialBlocks}" Background="#0B0D14" BorderBrush="#1F2636">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#161B26" CornerRadius="5" Padding="8" Margin="0,3" BorderBrush="#262D3D" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13" DockPanel.Dock="Left"/>
                                                <Button Content="📢 LANZAR AHORA" 
                                                        Command="{Binding DataContext.TriggerCommercialBlockNowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CommercialButtonStyle}" 
                                                        Padding="6,3" FontSize="9" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                            </DockPanel>

                                            <DockPanel Grid.Row="1" Margin="0,3">
                                                <TextBlock Text="{Binding ScheduleText}" Foreground="#FFEA00" FontSize="10" FontFamily="Consolas" DockPanel.Dock="Left"/>
                                                <TextBlock Text="{Binding TotalDurationFormatted, StringFormat='Duración: {0}'}" Foreground="#8A99AD" FontSize="10" DockPanel.Dock="Right"/>
                                            </DockPanel>

                                            <DockPanel Grid.Row="2" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Spots.Count, StringFormat='Cuñas: {0}'}" Foreground="#00E676" FontSize="10" DockPanel.Dock="Left"/>
                                                <Button Content="+ Agregar Spot" 
                                                        Command="{Binding DataContext.AddSpotToBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource StudioButtonStyle}" Padding="5,2" FontSize="9" DockPanel.Dock="Right"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>

                <!-- TAB 6: STREAMING & METADATA -->
                <TabItem Header="STREAMING">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- STREAMING CONTROL -->
                        <Border Grid.Row="0" Background="#11141F" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="{Binding StreamingService.StatusColor}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding StreamingService.StreamingStatusText}" FontWeight="Bold" Foreground="#00E5FF" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Command="{Binding TestIcecastConnectionCommand}" Style="{StaticResource StudioButtonStyle}" Content="🔍 PROBAR" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                        <Button Command="{Binding ToggleStreamingCommand}" Style="{StaticResource StudioButtonStyle}" Content="{Binding StreamingService.StreamingButtonText}" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding StreamingService.StatusMessage}" FontSize="9" Foreground="#8A99AD" Margin="0,0,0,4" TextWrapping="Wrap"/>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Servidor:" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.ServerUrl, UpdateSourceTrigger=PropertyChanged}" Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#262D3D" Padding="3" Width="150" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Puerto:" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.ServerPort, UpdateSourceTrigger=PropertyChanged}" Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#262D3D" Padding="3" Width="60" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Mountpoint:" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.MountPoint, UpdateSourceTrigger=PropertyChanged}" Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#262D3D" Padding="3" Width="120" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Password:" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.Password, UpdateSourceTrigger=PropertyChanged}" Background="#0B0D14" Foreground="#FFEA00" BorderBrush="#262D3D" Padding="3" Width="100" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="FFmpeg:" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                        <TextBox Text="{Binding StreamingService.FFmpegPath, UpdateSourceTrigger=PropertyChanged}" Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#262D3D" Padding="3" Width="120" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="ESTADÍSTICAS DE STREAMING" FontSize="10" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,4"/>

                                    <TextBlock Text="Conexión:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding StreamingService.ConnectionTimeFormatted}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>

                                    <TextBlock Text="Duración:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding StreamingService.StreamDurationFormatted}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>

                                    <TextBlock Text="Datos enviados:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding StreamingService.BytesSentFormatted}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>

                                    <TextBlock Text="Bitrate:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding StreamingService.Bitrate, StringFormat='{}{0} kbps'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>

                                    <TextBlock Text="Circuit breaker:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding StreamingService.CircuitBreakerState}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>

                                    <TextBlock Text="Paquetes descartados:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding StreamingService.BufferOverrunCount}" FontSize="10" FontWeight="Bold" Foreground="#FF9100"/>
                                    <TextBlock Text="Silencios por underrun:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding StreamingService.BufferUnderrunCount}" FontSize="10" FontWeight="Bold" Foreground="#FFEA00"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- NOW PLAYING METADATA -->
                        <Border Grid.Row="1" Background="#11141F" CornerRadius="5" Padding="10" BorderBrush="#262D3D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="EXPORTACIÓN NOWPLAYING (RDS / TXT / JSON)" FontSize="11" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,6"/>

                                <TextBlock Text="Tema al Aire Actual:" FontSize="9" Foreground="#8A99AD"/>
                                <Border Background="#0B0D14" CornerRadius="4" Padding="6" Margin="0,2,0,6" BorderBrush="#1F2636" BorderThickness="1">
                                    <TextBlock Text="{Binding CurrentNowPlayingText}" FontWeight="Bold" Foreground="#FFEA00" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </Border>

                                <TextBlock Text="Archivos exportados:" FontSize="10" Foreground="#A0AEC0"/>
                                <TextBlock Text="• nowplaying.txt (RDS / Transmisor / OBS)" FontSize="9" Foreground="#00E676"/>
                                <TextBlock Text="• nowplaying.json (Web App HTML5)" FontSize="9" Foreground="#00E676"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 7: GRABACIÓN DE EMISIONES -->
                <TabItem Header="GRABACIÓN">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- CONTROL DE GRABACIÓN -->
                        <Border Grid.Row="0" Background="#11141F" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="{Binding RecordingService.StatusColor}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding RecordingService.RecordingStatusText}" FontWeight="Bold" Foreground="#FF1744" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <Button Command="{Binding ToggleRecordingCommand}" Style="{StaticResource StudioButtonStyle}" Content="{Binding RecordingService.RecordingButtonText}" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#FF1744" BorderBrush="#FF5252"/>
                                    </DockPanel>

                                    <TextBlock Text="Grabando audio del sistema (loopback)" FontSize="9" Foreground="#8A99AD" Margin="0,0,0,4"/>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Archivo:" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding RecordingService.CurrentFileName}" FontWeight="Bold" Foreground="#00E5FF" FontSize="10" DockPanel.Dock="Right"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="Carpeta:" FontSize="9" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding RecordingService.RecordingFolder}" FontSize="10" Foreground="#FFFFFF" DockPanel.Dock="Right"/>
                                    </DockPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="ESTADÍSTICAS DE GRABACIÓN" FontSize="10" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,4"/>

                                    <TextBlock Text="Inicio:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding RecordingService.RecordingStartTimeFormatted}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>

                                    <TextBlock Text="Duración:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding RecordingService.RecordingDurationFormatted}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4"/>

                                    <TextBlock Text="Tamaño:" FontSize="9" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding RecordingService.BytesRecordedFormatted}" FontSize="10" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CONTROLES DE ARCHIVOS -->
                        <Border Grid.Row="1" Background="#11141F" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                            <UniformGrid Columns="2">
                                <Button Command="{Binding OpenRecordingFolderCommand}" Style="{StaticResource StudioButtonStyle}" Content="📁 ABRIR CARPETA" Margin="0,0,4,0"/>
                                <Button Command="{Binding DeleteRecordingCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑️ ELIMINAR SELECCIONADO" Margin="4,0,0,0" Background="#FF6D00" BorderBrush="#FF9100"/>
                            </UniformGrid>
                        </Border>

                        <!-- LISTA DE GRABACIONES -->
                        <Border Grid.Row="2" Background="#11141F" CornerRadius="5" Padding="10" BorderBrush="#262D3D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ARCHIVOS DE GRABACIÓN" FontSize="11" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,6"/>
                                <TextBlock Text="Las grabaciones se guardan en formato WAV de alta calidad (44.1kHz, 16-bit, estéreo)" FontSize="9" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                <TextBlock Text="Ubicación: grabaciones/ (en el directorio del proyecto)" FontSize="9" Foreground="#FFEA00" Margin="0,0,0,6"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 8: ESTADÍSTICAS -->
                <TabItem Header="ESTADÍSTICAS">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- RESUMEN GENERAL -->
                        <Border Grid.Row="0" Background="#11141F" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="TRACKS EN SESIÓN" FontSize="10" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.SessionTrackCount}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                    <TextBlock Text="TIEMPO TOTAL" FontSize="10" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.TotalSessionPlayTime, StringFormat='{}{0:hh\\:mm\\:ss}'}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                    <TextBlock Text="TRACKS ÚNICOS" FontSize="10" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.TotalUniqueTracks}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3">
                                    <TextBlock Text="REGISTROS TOTALES" FontSize="10" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding StatisticsService.TotalPlaybackRecords}" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" FontFamily="Consolas"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- CONTROLES DE ESTADÍSTICAS -->
                        <Border Grid.Row="1" Background="#11141F" CornerRadius="5" Padding="10" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                            <UniformGrid Columns="4">
                                <Button Command="{Binding GenerateStatisticsReportCommand}" Style="{StaticResource StudioButtonStyle}" Content="📊 GENERAR REPORTE" Margin="0,0,4,0" Background="#00B0FF" BorderBrush="#00E5FF"/>
                                <Button Command="{Binding SaveStatisticsCommand}" Style="{StaticResource StudioButtonStyle}" Content="💾 GUARDAR" Margin="4,0,4,0"/>
                                <Button Command="{Binding LoadStatisticsCommand}" Style="{StaticResource StudioButtonStyle}" Content="📂 CARGAR" Margin="4,0,4,0"/>
                                <Button Command="{Binding ClearStatisticsCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑️ LIMPIAR" Margin="4,0,0,0" Background="#FF6D00" BorderBrush="#FF9100"/>
                            </UniformGrid>
                        </Border>

                        <!-- INFORMACIÓN -->
                        <Border Grid.Row="2" Background="#11141F" CornerRadius="5" Padding="10" BorderBrush="#262D3D" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="SISTEMA DE ESTADÍSTICAS" FontSize="11" FontWeight="Bold" Foreground="#00E676" Margin="0,0,0,6"/>
                                <TextBlock Text="El sistema registra automáticamente cada reproducción con información detallada:" FontSize="9" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                <TextBlock Text="• Tracks más populares por número de reproducciones" FontSize="9" Foreground="#00E676" Margin="0,0,0,2"/>
                                <TextBlock Text="• Tiempo total de reproducción por track" FontSize="9" Foreground="#00E676" Margin="0,0,0,2"/>
                                <TextBlock Text="• Estadísticas por hora del día" FontSize="9" Foreground="#00E676" Margin="0,0,0,2"/>
                                <TextBlock Text="• Estadísticas por género musical" FontSize="9" Foreground="#00E676" Margin="0,0,0,2"/>
                                <TextBlock Text="• Historial de reproducciones diario" FontSize="9" Foreground="#00E676" Margin="0,0,0,2"/>
                                <TextBlock Text="• Reportes exportables en formato texto" FontSize="9" Foreground="#00E676" Margin="0,0,0,6"/>
                                <TextBlock Text="Los datos se guardan en formato JSON para persistencia entre sesiones." FontSize="9" Foreground="#FFEA00"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ================= STATUS FOOTER BAR ================= -->
        <Border Grid.Row="3" Background="#11141F" CornerRadius="4" Padding="10,5" Margin="0,8,0,0" BorderBrush="#1F2636" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="#00E676" FontSize="11" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="CurrentUserText" Foreground="#A0AEC0" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button x:Name="ManageUsersButton" Content="USUARIOS" Click="OnManageUsersClick" Background="#26343D" Foreground="#FFFFFF" BorderThickness="0" Padding="8,3" Margin="0,0,6,0"/>
                    <Button Content="CERRAR SESIÓN" Click="OnLogoutClick" Background="#6E3030" Foreground="#FFFFFF" BorderThickness="0" Padding="8,3" Margin="0,0,12,0"/>
                    <TextBlock Text="Quasar Radio Pro v3.0" Foreground="#55657B" FontSize="10" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
