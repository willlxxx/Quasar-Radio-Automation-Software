<Window x:Class="quasar_radio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:quasar_radio"
        Title="Quasar Radio Pro v3.0 - Suite Radial de Emisión &amp; Automatización" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        Background="{Binding WindowBackground}" Foreground="#E0E6ED">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="1"/>
        <KeyBinding Key="F2" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="2"/>
        <KeyBinding Key="F3" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="3"/>
        <KeyBinding Key="F4" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="4"/>
        <KeyBinding Key="F5" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="5"/>
        <KeyBinding Key="F6" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="6"/>
        <KeyBinding Key="F7" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="7"/>
        <KeyBinding Key="F8" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="8"/>
        <KeyBinding Key="F9" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="9"/>
        <KeyBinding Key="F10" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="10"/>
        <KeyBinding Key="F11" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="11"/>
        <KeyBinding Key="F12" Command="{Binding CartWallViewModel.TriggerCartPadCommand}" CommandParameter="12"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="Button" x:Key="StudioButtonStyle">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3548"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A3245"/>
                                <Setter Property="BorderBrush" Value="#00B0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#151922"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PlayButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="#00C853"/>
            <Setter Property="BorderBrush" Value="#00E676"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E676"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="StopButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="#D50000"/>
            <Setter Property="BorderBrush" Value="#FF1744"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1744"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="NextButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="#2979FF"/>
            <Setter Property="BorderBrush" Value="#448AFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#448AFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="CommercialButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="#FF6D00"/>
            <Setter Property="BorderBrush" Value="#FF9100"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF9100"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="MicButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="{Binding MicButtonColor}"/>
            <Setter Property="BorderBrush" Value="#FF1744"/>
        </Style>

        <Style x:Key="DeckGlowBorderStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="#262D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#111722"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="0" ShadowDepth="0" Opacity="0" Color="#00E5FF"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="#00E5FF"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                    <Setter Property="BorderBrush" Value="#A855F7"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.85" Color="#A855F7"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeckAActiveChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#1E2A37"/>
            <Setter Property="BorderBrush" Value="#2A3A4D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.25" Color="#00E5FF"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                    <Setter Property="Background" Value="#00B0FF"/>
                    <Setter Property="BorderBrush" Value="#7DE7FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.9" Color="#00E5FF"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeckBActiveChipStyle" TargetType="Border">
            <Setter Property="Background" Value="#2B213F"/>
            <Setter Property="BorderBrush" Value="#5F4A73"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.25" Color="#A855F7"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DeckB_IsActive}" Value="True">
                    <Setter Property="Background" Value="#8A3FFC"/>
                    <Setter Property="BorderBrush" Value="#D8B4FF"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.9" Color="#A855F7"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header / Studio Bar -->
            <RowDefinition Height="210"/>  <!-- Dashboard / Dual Deck A & B Panel -->
            <RowDefinition Height="*"/>    <!-- Rejilla de Emisión & Tabs -->
            <RowDefinition Height="Auto"/> <!-- Status Footer Bar -->
        </Grid.RowDefinitions>

        <!-- ================= PANEL SUPERIOR / HEADER ================= -->
        <Border Grid.Row="0" Background="{Binding CardBackground}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="#262D3D" BorderThickness="1" DataContext="{Binding ThemeViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LOGO Y NOMBRE DE LA EMISORA -->
                <Button Grid.Column="0" Command="{Binding ChangeStationLogoCommand}" Background="Transparent" BorderThickness="0" ToolTip="Haz clic para cambiar el logo de la emisora">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding StationLogoPath}" Width="36" Height="36" Margin="0,0,10,0">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCustomLogo}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Border Width="12" Height="12" CornerRadius="6" Background="{Binding AccentColor}" Margin="0,0,10,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCustomLogo}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataContext.AudioPlayerViewModel.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter Property="Background" Value="#555555"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <TextBlock Text="QUASAR RADIO" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="PRO v3.0" FontSize="12" FontWeight="Bold" Foreground="#00B0FF" VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                </Button>

                <!-- BADGES ESTADO: REPRODUCIENDO / MIC LIVE / STREAM LIVE -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#00E676" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.AudioPlayerViewModel.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Background" Value="#262D3D"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="REPRODUCIENDO" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <Border Background="#FF1744" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.AudioPlayerViewModel.IsPlaying, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Content="AL AIRE" Background="Transparent" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" BorderThickness="0" Padding="0"/>
                    </Border>

                    <Border Background="#D50000" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsMicActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="🎤 MIC LIVE" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                    </Border>

                    <Border Background="#00E5FF" CornerRadius="4" Padding="10,3" Margin="5,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.StreamingViewModel.StreamingService.IsStreamingActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="📡 STREAM LIVE" FontSize="11" FontWeight="Bold" Foreground="#000000"/>
                    </Border>
                </StackPanel>

                <!-- SELECTOR DE TEMAS -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="Tema:" FontSize="11" Foreground="#8A99AD" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme}" Width="130" Height="26" FontSize="11" IsEnabled="{Binding DataContext.IsAdmin, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>

                <!-- BOTÓN ANUNCIAR HORA -->
                <Button Grid.Column="3" Command="{Binding DataContext.AnnounceTimeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StudioButtonStyle}" Margin="0,0,10,0" Padding="8,4">
                    <TextBlock Text="🕒 HORA" FontWeight="Bold" Foreground="#00E5FF"/>
                </Button>

                <!-- BOTÓN GESTIÓN DE LIBRERÍA -->
                <Button Grid.Column="4" Command="{Binding DataContext.LibraryViewModel.OpenLibraryManagementCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StudioButtonStyle}" Margin="0,0,10,0" Padding="8,4" Background="#00B0FF" BorderBrush="#00E5FF">
                    <TextBlock Text="🎵 LIBRERÍA" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Button>

                <!-- CUENTA REGRESIVA PRÓXIMA TANDA -->
                <Border Grid.Column="5" Background="#1A1800" CornerRadius="6" Padding="10,4" Margin="0,0,10,0" BorderBrush="#FFD600" BorderThickness="1">
                    <TextBlock Text="{Binding DataContext.NextCommercialCountdown, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11" FontWeight="Bold" Foreground="#FFEA00" VerticalAlignment="Center"/>
                </Border>

                <!-- BOTÓN AUTO / MANUAL -->
                <Button Grid.Column="6" Command="{Binding DataContext.AudioPlayerViewModel.ToggleAutoModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource StudioButtonStyle}" Margin="0,0,10,0" Padding="8,4">
                    <TextBlock Text="{Binding DataContext.AudioPlayerViewModel.AutoModeText, RelativeSource={RelativeSource AncestorType=Window}}" FontWeight="Bold" Foreground="{Binding DataContext.AudioPlayerViewModel.AutoModeColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Button>

                <!-- RELOJ DIGITAL DE ESTUDIO -->
                <Border Grid.Column="7" Background="#0B0D14" CornerRadius="6" Padding="12,3" BorderBrush="#1F2636" BorderThickness="1">
                    <TextBlock Text="{Binding DataContext.StudioClock, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="22" FontFamily="Consolas, Courier New" FontWeight="Bold" Foreground="{Binding AccentColor}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ================= MONITOR PRINCIPAL / DUAL DECK A & B PANEL ================= -->
        <Grid Grid.Row="1" Margin="0,0,0,12" DataContext="{Binding AudioPlayerViewModel}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/> <!-- Deck A Card -->
                <ColumnDefinition Width="1*"/> <!-- Deck B Card -->
                <ColumnDefinition Width="1.1*"/> <!-- Panel de Control Master & VU Meter -->
            </Grid.ColumnDefinitions>

            <!-- CARD DECK A -->
            <Border Grid.Column="0" Style="{StaticResource DeckGlowBorderStyle}" CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <Border DockPanel.Dock="Left" Style="{StaticResource DeckAActiveChipStyle}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <TextBlock Text="DECK A" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Border>
                    </DockPanel>

                    <Border Grid.Row="1" Background="#0D1320" BorderBrush="#53D5FF" BorderThickness="1.5" CornerRadius="6" Padding="8,7" Margin="0,8,0,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#0D1320"/>
                                <Setter Property="BorderBrush" Value="#53D5FF"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                        <Setter Property="Background" Value="#0E1E2F"/>
                                        <Setter Property="BorderBrush" Value="#53D5FF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Effect>
                            <DropShadowEffect Color="#2ED5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.7"/>
                        </Border.Effect>
                        <Border ClipToBounds="True" CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="{Binding DeckA_Title}" FontSize="24" FontWeight="Bold" Foreground="#F4FBFF" VerticalAlignment="Center" ToolTip="{Binding DeckA_Title}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform/>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-220" Duration="0:0:8" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1" Text="{Binding DeckA_RemainingFormatted}" Foreground="#FFEA00" FontSize="12" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </Grid>
                        </Border>
                    </Border>

                    <Border Grid.Row="2" Background="#080B12" CornerRadius="4" Padding="4,4" Margin="0,0,0,4" BorderBrush="#384B63" BorderThickness="1.2">
                        <local:LedVuMeterControl Value="{Binding DeckA_VuLevel, Mode=OneWay}" SegmentCount="18" Height="20" Width="220"/>
                    </Border>

                    <ProgressBar Grid.Row="3" Value="{Binding DeckA_Progress, Mode=OneWay}" Height="10" Background="#0B0D14" Foreground="#00E676" BorderThickness="0" Margin="0,4"/>

                    <StackPanel Grid.Row="4" Margin="0,2,0,0">
                        <Border Background="#0B0D14" CornerRadius="4" Padding="3,2" Margin="0,0,0,2">
                            <Grid Height="24">
                                <ItemsControl ItemsSource="{Binding DeckA_Spectrum}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="18"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Height="24" Margin="1,0">
                                                <Border Background="#10212B" CornerRadius="2"/>
                                                <Border Height="{Binding}" Background="#00E5FF" VerticalAlignment="Bottom" CornerRadius="2"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            <UniformGrid Columns="18" Height="26" Visibility="Collapsed">
                                <Rectangle Fill="#00E5FF" Width="4" RadiusX="2" RadiusY="2" Opacity="0.25" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="8"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="6" To="22" Duration="0:0:0.28" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="#00E5FF" Width="4" RadiusX="2" RadiusY="2" Opacity="0.35" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="10"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="8" To="18" Duration="0:0:0.32" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="#00E5FF" Width="4" RadiusX="2" RadiusY="2" Opacity="0.45" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="12"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="10" To="24" Duration="0:0:0.25" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="#00E5FF" Width="4" RadiusX="2" RadiusY="2" Opacity="0.6" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="14"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="12" To="26" Duration="0:0:0.23" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="#00E5FF" Width="4" RadiusX="2" RadiusY="2" Opacity="0.8" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="14" To="28" Duration="0:0:0.2" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="#00E5FF" Width="4" RadiusX="2" RadiusY="2" Opacity="1" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="18"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Height" From="16" To="30" Duration="0:0:0.18" AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                                <Rectangle Fill="#00E5FF" Width="4" RadiusX="2" RadiusY="2" Opacity="0.8" Margin="0,0,1,0">
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Setter Property="Height" Value="16"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DeckA_IsActive}" Value="True">
