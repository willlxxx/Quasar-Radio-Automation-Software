<Window x:Class="quasar_radio.StreamingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:quasar_radio"
        Title="Streaming y Grabación - Quasar Radio"
        Width="1080" Height="700" MinWidth="820" MinHeight="520"
        Background="{DynamicResource Brush.Surface.Base}" Foreground="{DynamicResource Brush.Text.Default}">

    <!-- Una sola ventana para los dos dominios que en la consola vieja eran dos pestañas:
         enlace Icecast y grabadora de emisión. -->

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- CABECERA: estado de los dos servicios -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="STREAMING Y GRABACIÓN" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
                    <TextBlock Text="Enlace Icecast, exportación nowplaying y grabadora de emisión" FontSize="10" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="4" Padding="8,4" Margin="8,0" VerticalAlignment="Center" BorderBrush="{Binding StreamingService.StatusColor}" BorderThickness="1">
                    <TextBlock Text="{Binding StreamingService.StreamingStatusText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}"/>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" BorderBrush="{Binding RecordingService.StatusColor}" BorderThickness="1">
                    <TextBlock Text="{Binding RecordingService.RecordingStatusText}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Danger}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- ICECAST -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock Text="Salida del enlace" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Command="{Binding TestIcecastConnectionCommand}" Style="{StaticResource StudioButtonStyle}" Content="🔍 PROBAR" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="0,0,4,0"/>
                                <Button Command="{Binding ToggleStreamingCommand}" Style="{StaticResource StudioButtonStyle}" Content="{Binding StreamingService.StreamingButtonText}" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <TextBlock Text="{Binding StreamingService.StatusMessage}" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4" TextWrapping="Wrap"/>

                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Servidor:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding StreamingService.ServerUrl, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="150" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Puerto:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding StreamingService.ServerPort, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="60" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Mountpoint:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding StreamingService.MountPoint, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="120" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Password:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding StreamingService.Password, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Accent.Warn}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="100" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="FFmpeg:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBox Text="{Binding StreamingService.FFmpegPath, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Brush.Surface.Deep}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Default}" Padding="3" Width="120" DockPanel.Dock="Right" IsEnabled="{Binding IsAdmin}"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="SALUD DEL ENLACE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>

                            <TextBlock Text="Conexión:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding StreamingService.ConnectionTimeFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4" FontFamily="{StaticResource Sys.Font.Clock}"/>

                            <TextBlock Text="Duración:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding StreamingService.StreamDurationFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4" FontFamily="{StaticResource Sys.Font.Clock}"/>

                            <TextBlock Text="Datos enviados:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding StreamingService.BytesSentFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,4" FontFamily="{StaticResource Sys.Font.Clock}"/>

                            <TextBlock Text="Bitrate:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding StreamingService.Bitrate, StringFormat='{}{0} kbps'}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4" FontFamily="{StaticResource Sys.Font.Clock}"/>

                            <TextBlock Text="Circuit breaker:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding StreamingService.CircuitBreakerState}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,0,4"/>

                            <TextBlock Text="Paquetes descartados:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding StreamingService.BufferOverrunCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Orange}" FontFamily="{StaticResource Sys.Font.Clock}"/>
                            <TextBlock Text="Silencios por underrun:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding StreamingService.BufferUnderrunCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Warn}" FontFamily="{StaticResource Sys.Font.Clock}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- NOWPLAYING -->
                <Border Grid.Row="1" VerticalAlignment="Top" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="EXPORTACIÓN NOWPLAYING (RDS / TXT / JSON)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,6"/>

                        <TextBlock Text="Tema al Aire Actual:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                        <Border Background="{DynamicResource Brush.Surface.Deep}" CornerRadius="4" Padding="6" Margin="0,2,0,6" BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="1">
                            <TextBlock Text="{Binding CurrentNowPlayingText}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Warn}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </Border>

                        <TextBlock Text="Archivos exportados:" FontSize="10" Foreground="{DynamicResource Brush.Text.Muted}"/>
                        <TextBlock Text="• nowplaying.txt (RDS / Transmisor / OBS)" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}"/>
                        <TextBlock Text="• nowplaying.json (Web App HTML5)" FontSize="9" Foreground="{DynamicResource Brush.Accent.Success}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- GRABADORA -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock Text="Grabadora de emisión" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Danger}" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Command="{Binding ToggleRecordingCommand}" Style="{StaticResource StudioButtonStyle}" Content="{Binding RecordingService.RecordingButtonText}" Padding="6,3" FontSize="10" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="{DynamicResource Brush.Accent.Danger}" BorderBrush="{DynamicResource Brush.Accent.DangerSoft}"/>
                            </DockPanel>

                            <TextBlock Text="Grabando audio del sistema (loopback)" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,4"/>

                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Archivo:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding RecordingService.CurrentFileName}" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" FontSize="10" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>

                            <DockPanel LastChildFill="False" Margin="0,0,0,4">
                                <TextBlock Text="Carpeta:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding RecordingService.RecordingFolder}" FontSize="10" Foreground="{DynamicResource Brush.Text.High}" DockPanel.Dock="Right" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="ARCHIVO ACTUAL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,4"/>

                            <TextBlock Text="Inicio:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding RecordingService.RecordingStartTimeFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4" FontFamily="{StaticResource Sys.Font.Clock}"/>

                            <TextBlock Text="Duración:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding RecordingService.RecordingDurationFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}" Margin="0,0,0,4" FontFamily="{StaticResource Sys.Font.Clock}"/>

                            <TextBlock Text="Tamaño:" FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}"/>
                            <TextBlock Text="{Binding RecordingService.BytesRecordedFormatted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" FontFamily="{StaticResource Sys.Font.Clock}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="10" Margin="0,0,0,12" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <!-- Etiquetas cortas: en una columna de ~500 px tres botones a tercios
                         no caben con "ELIMINAR SELECCIONADO" entero (quedaba "SELECCIO"). -->
                    <UniformGrid Columns="3">
                        <Button Command="{Binding OpenRecordingFolderCommand}" Style="{StaticResource StudioButtonStyle}" Content="📁 CARPETA" FontSize="10" Padding="4,0" Margin="0,0,4,0" ToolTip="Abrir la carpeta de grabaciones"/>
                        <Button Command="{Binding RefreshRecordingFilesCommand}" Style="{StaticResource StudioButtonStyle}" Content="🔄 ACTUALIZAR" FontSize="10" Padding="4,0" Margin="0,0,4,0" ToolTip="Volver a leer la carpeta de grabaciones"/>
                        <Button Command="{Binding DeleteRecordingCommand}" CommandParameter="{Binding SelectedItem, ElementName=RecordingList}"
                                Style="{StaticResource StudioButtonStyle}" Content="🗑️ ELIMINAR" FontSize="10" Padding="4,0" ToolTip="Borrar la grabación seleccionada de la lista"
                                Background="{DynamicResource Brush.Accent.OrangeDeep}" BorderBrush="{DynamicResource Brush.Accent.Orange}"/>
                    </UniformGrid>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource Brush.Surface.Card}" CornerRadius="8" Padding="10" BorderBrush="{DynamicResource Brush.Border.Default}" BorderThickness="1">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="ARCHIVOS DE GRABACIÓN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent.Success}" Margin="0,0,0,6"/>
                            <TextBlock Text="WAV de alta calidad (44.1 kHz, 16 bits, estéreo) en la carpeta grabaciones/ del programa. Selecciona uno para borrarlo." FontSize="9" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                        </StackPanel>
                        <!-- La pestaña vieja no listaba nada: RecordingFiles no se llenaba y
                             ELIMINAR no recibia parametro. Aqui se rellena al abrir y el boton
                             borra lo seleccionado. -->
                        <ListBox x:Name="RecordingList" ItemsSource="{Binding RecordingFiles}"
                                 Background="{DynamicResource Brush.Surface.Deep}" BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                 FontSize="10" Foreground="{DynamicResource Brush.Text.High}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource Brush.Text.High}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
