<Window x:Class="quasar_radio.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quasar Radio | Identifícate" Height="430" Width="430"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Topmost="True" ShowInTaskbar="True"
        Background="{DynamicResource Brush.Surface.BaseAlt}" Foreground="{DynamicResource Brush.Text.AltHigh}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="QUASAR RADIO" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Brush.Text.High}"/>
            <TextBlock x:Name="SubtitleText" Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource Brush.Text.Alt}" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Usuario" FontSize="11" Foreground="{DynamicResource Brush.Text.Alt}" Margin="0,0,0,5"/>
            <TextBox x:Name="UsernameBox" Height="36" Padding="9,6" Background="{DynamicResource Brush.Surface.CardAlt}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Alt}"/>
            <TextBlock Text="Contraseña" FontSize="11" Foreground="{DynamicResource Brush.Text.Alt}" Margin="0,14,0,5"/>
            <PasswordBox x:Name="PasswordBox" Height="36" Padding="9,6" Background="{DynamicResource Brush.Surface.CardAlt}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Alt}"/>
            <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
                <TextBlock Text="Confirmar contraseña" FontSize="11" Foreground="{DynamicResource Brush.Text.Alt}" Margin="0,14,0,5"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Height="36" Padding="9,6" Background="{DynamicResource Brush.Surface.CardAlt}" Foreground="{DynamicResource Brush.Text.High}" BorderBrush="{DynamicResource Brush.Border.Alt}"/>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Margin="0,12,0,0" Foreground="{DynamicResource Brush.Accent.Coral}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- AUTH-1: desde que este dialogo es un sello de accion y no la puerta del programa,
             hace falta poder decir «mejor no». Cerrar con la X o con VOLVER equivale a
             cancelar la operacion que lo pidio; la accion no se hace y nada se escribe. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="VOLVER" Height="40" Background="{DynamicResource Brush.Surface.CardAlt}" Foreground="{DynamicResource Brush.Text.Alt}" BorderBrush="{DynamicResource Brush.Border.Alt}" FontWeight="Bold" Click="OnCancelClick"
                    AutomationProperties.Name="Volver sin realizar la accion"/>
            <Button Grid.Column="2" Content="CONTINUAR" Height="40" Background="{DynamicResource Brush.Accent.Teal}" Foreground="{DynamicResource Brush.Text.High}" BorderThickness="0" FontWeight="Bold" Click="OnSubmitClick"
                    AutomationProperties.Name="Identificarse y continuar"/>
        </Grid>
    </Grid>
</Window>
