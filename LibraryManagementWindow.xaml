<Window x:Class="quasar_radio.LibraryManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:quasar_radio"
        Title="Gestión de Librería Musical - Quasar Radio Pro" 
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#0B0D14" 
        Foreground="#E0E6ED"
        ResizeMode="CanResize">

    <Window.Resources>
        <Style TargetType="Button" x:Key="StudioButtonStyle">
            <Setter Property="Background" Value="#1E2330"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#2D3548"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2A3245"/>
                                <Setter Property="BorderBrush" Value="#00B0FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#151922"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="AccentButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="#00B0FF"/>
            <Setter Property="BorderBrush" Value="#00E5FF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="SuccessButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="#00C853"/>
            <Setter Property="BorderBrush" Value="#00E676"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#00E676"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button" x:Key="DangerButtonStyle" BasedOn="{StaticResource StudioButtonStyle}">
            <Setter Property="Background" Value="#D50000"/>
            <Setter Property="BorderBrush" Value="#FF1744"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FF1744"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#11141F"/>
            <Setter Property="Foreground" Value="#A0AEC0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" Margin="2,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#1A202C"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B0D14"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2D3548"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#0B0D14"/>
            <Setter Property="Foreground" Value="#E0E6ED"/>
            <Setter Property="Padding" Value="8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1A202C"/>
                    <Setter Property="Foreground" Value="#00E5FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1A202C"/>
                    <Setter Property="Foreground" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#1A202C" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" BorderBrush="#262D3D" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🎵" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GESTIÓN DE LIBRERÍA MUSICAL" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Administración avanzada de tracks, metadatos y puntos CUE" FontSize="12" Foreground="#8A99AD" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding RefreshLibraryCommand}" Style="{StaticResource StudioButtonStyle}" Content="🔄 Recargar" Margin="0,0,8,0"/>
                    <Button Command="{Binding CloseWindowCommand}" Style="{StaticResource DangerButtonStyle}" Content="✖ Cerrar"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- CONTENIDO PRINCIPAL CON TABS -->
        <TabControl Grid.Row="1" Background="#11141F" BorderBrush="#262D3D" BorderThickness="1">
            
            <!-- TAB 1: BÚSQUEDA Y FILTROS -->
            <TabItem Header="🔍 BÚSQUEDA Y FILTROS">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Filtros Principales -->
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Búsqueda General" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" 
                                         Padding="8" FontSize="11" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Filtro Año" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding GetYearRange()}" SelectedItem="{Binding FilterYear}" 
                                          Style="{StaticResource {x:Type ComboBox}}"
                                          FontSize="11" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="Filtro Artista" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FilterArtist, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" 
                                         Padding="8" FontSize="11" Height="32"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3">
                                <TextBlock Text="Acciones" FontSize="11" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,4"/>
                                <UniformGrid Columns="2" Height="32">
                                    <Button Command="{Binding SearchCommand}" Style="{StaticResource AccentButtonStyle}" Content="🔍 Buscar" Margin="0,0,4,0"/>
                                    <Button Command="{Binding SmartSearchCommand}" Style="{StaticResource StudioButtonStyle}" Content="🧠 Smart" Margin="4,0,0,0"/>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Filtros Avanzados -->
                    <Border Grid.Row="1" Background="#161B26" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Prioridad Mínima" FontSize="10" Foreground="#8A99AD" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding GetPriorityRange()}" SelectedItem="{Binding FilterMinPriority}" 
                                          Style="{StaticResource {x:Type ComboBox}}"
                                          FontSize="10" Height="26"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                <TextBlock Text="Prioridad Máxima" FontSize="10" Foreground="#8A99AD" Margin="0,0,0,2"/>
                                <ComboBox ItemsSource="{Binding GetPriorityRange()}" SelectedItem="{Binding FilterMaxPriority}" 
                                          Style="{StaticResource {x:Type ComboBox}}"
                                          FontSize="10" Height="26"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                <TextBlock Text="BPM Mínimo" FontSize="10" Foreground="#8A99AD" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding FilterMinBpm, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" 
                                         Padding="6" FontSize="10" Height="26"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,8,0">
                                <TextBlock Text="BPM Máximo" FontSize="10" Foreground="#8A99AD" Margin="0,0,0,2"/>
                                <TextBox Text="{Binding FilterMaxBpm, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" 
                                         Padding="6" FontSize="10" Height="26"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <Button Command="{Binding ClearFiltersCommand}" Style="{StaticResource StudioButtonStyle}" Content="🗑️ Limpiar Filtros" Height="26"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Resultados -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedTrack}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#0B0D14" Foreground="#E0E6ED" RowBackground="#11141F" 
                              AlternatingRowBackground="#161B26" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1F2636"
                              BorderThickness="1" BorderBrush="#262D3D" RowHeight="28" SelectionMode="Single">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A202C"/>
                                <Setter Property="Foreground" Value="#A0AEC0"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Height" Value="30"/>
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="BorderBrush" Value="#2D3748"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#005599"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Icon" Binding="{Binding IconSymbol}" Width="40"/>
                            <DataGridTextColumn Header="Título" Binding="{Binding Title}" Width="2*"/>
                            <DataGridTextColumn Header="Artista" Binding="{Binding Artist}" Width="1.5*"/>
                            <DataGridTextColumn Header="Álbum" Binding="{Binding Album}" Width="1*"/>
                            <DataGridTextColumn Header="Género" Binding="{Binding Genre}" Width="80"/>
                            <DataGridTextColumn Header="Año" Binding="{Binding Year}" Width="60"/>
                            <DataGridTextColumn Header="Prioridad" Binding="{Binding PriorityFormatted}" Width="90"/>
                            <DataGridTextColumn Header="BPM" Binding="{Binding BpmFormatted}" Width="70"/>
                            <DataGridTextColumn Header="Duración" Binding="{Binding DurationFormatted}" Width="70" FontFamily="Consolas"/>
                            <DataGridTextColumn Header="Repro." Binding="{Binding PlayCount}" Width="50"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Estadísticas -->
                    <Border Grid.Row="3" Background="#161B26" CornerRadius="6" Padding="12" Margin="0,8,0,0" BorderBrush="#262D3D" BorderThickness="1">
                        <DockPanel>
                            <TextBlock Text="📊" FontSize="16" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding StatisticsText}" FontSize="11" Foreground="#00E5FF" DockPanel.Dock="Left"/>
                            <UniformGrid Columns="4" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                <ComboBox ItemsSource="{Binding GetSortOptions()}" SelectedItem="{Binding SortBy}" 
                                          Style="{StaticResource {x:Type ComboBox}}"
                                          FontSize="10" Height="26" Margin="0,0,4,0"/>
                                <CheckBox Content="Ascendente" IsChecked="{Binding SortAscending}" Foreground="#FFFFFF" FontSize="10" VerticalAlignment="Center" Margin="4,0,4,0"/>
                                <Button Command="{Binding UpdateStatisticsCommand}" Style="{StaticResource StudioButtonStyle}" Content="🔄 Stats" Margin="4,0,4,0" Height="26"/>
                            </UniformGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: EDICIÓN DE TRACKS -->
            <TabItem Header="✏️ EDICIÓN DE TRACKS">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Selección de Track -->
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="6" Padding="12" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="12" Foreground="#8A99AD" VerticalAlignment="Center">
                                <Run Text="Track seleccionado: "/>
                                <Run Text="{Binding SelectedTrack.Title, Mode=OneWay}" FontWeight="Bold" Foreground="#FFFFFF"/>
                                <Run Text=" - "/>
                                <Run Text="{Binding SelectedTrack.Artist, Mode=OneWay}" FontWeight="Bold" Foreground="#00E5FF"/>
                            </TextBlock>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Command="{Binding EditTrackCommand}" Style="{StaticResource AccentButtonStyle}" Content="📋 Ver Info" Margin="0,0,8,0"/>
                                <Button Command="{Binding DeleteTrackCommand}" Style="{StaticResource DangerButtonStyle}" Content="🗑️ Eliminar"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Panel de Edición -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Información del Track -->
                            <Border Background="#161B26" CornerRadius="6" Padding="16" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📋 INFORMACIÓN DEL TRACK" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Título" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Title, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="Artista" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Artist, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="Álbum" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Album, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Género" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Genre, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="Año" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Year, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="Prioridad (1-10)" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Priority, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Puntos CUE -->
                            <Border Background="#161B26" CornerRadius="6" Padding="16" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🎯 PUNTOS CUE" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Cue In (segundos)" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.CueInSeconds, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="Cue Out (segundos)" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.CueOutSeconds, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="Intro (segundos)" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.IntroSeconds, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Outro (segundos)" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.OutroSeconds, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="End Cue (segundos)" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.EndCueSeconds, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="BPM" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Bpm, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Fade Settings -->
                            <Border Background="#161B26" CornerRadius="6" Padding="16" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="🎚️ CONFIGURACIÓN DE FADE" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Fade In (segundos)" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.FadeIn, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Fade Out (segundos)" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.FadeOut, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Metadatos Adicionales -->
                            <Border Background="#161B26" CornerRadius="6" Padding="16" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="📝 METADATOS ADICIONALES" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                                    
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Compositor" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Composer, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>

                                        <TextBlock Text="Copyright" FontSize="11" Foreground="#8A99AD" Margin="0,8,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Copyright, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Comentarios" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedTrack.Comment, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" Padding="8" FontSize="11" Height="30" TextWrapping="Wrap" AcceptsReturn="True"/>
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Botones de Acción Rápida -->
                    <Border Grid.Row="2" Background="#161B26" CornerRadius="6" Padding="12" Margin="0,8,0,0" BorderBrush="#262D3D" BorderThickness="1">
                        <UniformGrid Columns="5">
                            <Button Command="{Binding IntelligentCuePointsCommand}" Style="{StaticResource AccentButtonStyle}" Content="🧠 CUE Inteligente" Margin="0,0,4,0"/>
                            <Button Command="{Binding NormalizeCuePointsCommand}" Style="{StaticResource StudioButtonStyle}" Content="📐 Normalizar" Margin="4,0,4,0"/>
                            <Button Command="{Binding ResetCuePointsCommand}" Style="{StaticResource StudioButtonStyle}" Content="🔄 Reset CUE" Margin="4,0,4,0"/>
                            <ComboBox ItemsSource="{Binding GetPresetOptions()}" SelectedItem="{Binding SelectedPreset}" 
                                      Style="{StaticResource {x:Type ComboBox}}"
                                      FontSize="10" Height="30" Margin="4,0,4,0"/>
                            <Button Command="{Binding ApplyPresetCommand}" CommandParameter="{Binding SelectedPreset}" Style="{StaticResource SuccessButtonStyle}" Content="✅ Aplicar Preset" Margin="4,0,0,0"/>
                        </UniformGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: IMPORTACIÓN Y ANÁLISIS -->
            <TabItem Header="🎯 IMPORTAR Y ANALIZAR">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Importación -->
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="6" Padding="16" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📥 IMPORTACIÓN DE TRACKS" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Género:" FontSize="11" Foreground="#8A99AD" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding DatabaseService.Genres}" SelectedItem="{Binding SelectedGenreForEdit}" 
                                              Style="{StaticResource {x:Type ComboBox}}"
                                              FontSize="11" Height="32"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Command="{Binding ImportTracksCommand}" Style="{StaticResource AccentButtonStyle}" Content="📁 Archivos" Margin="0,0,8,0" Height="32"/>
                                    <Button Command="{Binding ImportFolderCommand}" Style="{StaticResource StudioButtonStyle}" Content="📂 Carpeta" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Gestión de géneros -->
                    <Border Grid.Row="1" Background="#161B26" CornerRadius="6" Padding="16" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🎼 GESTIÓN DE GÉNEROS" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBox Text="{Binding NewGenreName, UpdateSourceTrigger=PropertyChanged}" 
                                             Background="#0B0D14" Foreground="#FFFFFF" BorderBrush="#2D3548" 
                                             Padding="8" FontSize="11" Width="200" Height="32" Margin="0,0,8,0"/>
                                    <Button Command="{Binding AddGenreCommand}" Style="{StaticResource SuccessButtonStyle}" Content="➕ Agregar" Height="32"/>
                                </StackPanel>

                                <ComboBox Grid.Column="1" ItemsSource="{Binding DatabaseService.Genres}" SelectedItem="{Binding SelectedGenreForEdit}" 
                                          Style="{StaticResource {x:Type ComboBox}}"
                                          FontSize="11" Width="150" Height="32" Margin="8,0,8,0"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Command="{Binding UpdateGenreCommand}" Style="{StaticResource AccentButtonStyle}" Content="✏️ Renombrar" Margin="0,0,8,0" Height="32"/>
                                    <Button Command="{Binding RemoveGenreCommand}" Style="{StaticResource DangerButtonStyle}" Content="🗑️ Eliminar" Height="32"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Análisis de audio -->
                    <Border Grid.Row="2" Background="#161B26" CornerRadius="6" Padding="16" BorderBrush="#262D3D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="🔊 ANÁLISIS INTELIGENTE DE AUDIO" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,8"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Selecciona un track y analiza sus características automáticamente: BPM, silencios, volumen, frecuencia" FontSize="11" Foreground="#8A99AD"/>
                                    <TextBlock Text="{Binding AnalysisStatus}" FontSize="11" Foreground="#00E5FF" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                    <Button Command="{Binding AnalyzeAudioCommand}" Style="{StaticResource AccentButtonStyle}" Content="🔍 Analizar" Height="32" Margin="0,0,8,0" IsEnabled="{Binding IsTrackSelected}"/>
                                    <Button Command="{Binding ApplyAutoCueCommand}" Style="{StaticResource StudioButtonStyle}" Content="🎯 AutoCue" Height="32" Margin="0,0,8,0"/>
                                    <Button Command="{Binding ApplyAutoGainCommand}" Style="{StaticResource StudioButtonStyle}" Content="📊 Ganancia" Height="32"/>
                                </StackPanel>
                            </Grid>

                            <!-- Resultados del análisis -->
                            <Border Background="#0B0D14" CornerRadius="4" Padding="12" Margin="0,8,0,0" BorderBrush="#2D3548" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="BPM" FontSize="10" Foreground="#8A99AD"/>
                                        <TextBlock Text="{Binding CurrentAnalysisResult.Bpm, StringFormat='{}{0:F0}'}" FontSize="18" FontWeight="Bold" Foreground="#00E5FF"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Pico" FontSize="10" Foreground="#8A99AD"/>
                                        <TextBlock Text="{Binding CurrentAnalysisResult.PeakAmplitude, StringFormat='{}{0:F2}'}" FontSize="18" FontWeight="Bold" Foreground="#FF9100"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="RMS" FontSize="10" Foreground="#8A99AD"/>
                                        <TextBlock Text="{Binding CurrentAnalysisResult.RmsAmplitude, StringFormat='{}{0:F2}'}" FontSize="18" FontWeight="Bold" Foreground="#00C853"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3">
                                        <TextBlock Text="Ganancia" FontSize="10" Foreground="#8A99AD"/>
                                        <TextBlock Text="{Binding CurrentAnalysisResult.RecommendedGain, StringFormat='{}{0:F2}'}" FontSize="18" FontWeight="Bold" Foreground="#E91E63"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: METADATOS Y PERSISTENCIA -->
            <TabItem Header="💾 METADATOS">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Información de Persistencia -->
                    <Border Grid.Row="0" Background="#161B26" CornerRadius="6" Padding="16" Margin="0,0,0,8" BorderBrush="#262D3D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="💾 GESTIÓN DE METADATOS" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                            
                            <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Los metadatos se almacenan en formato JSON para persistencia entre sesiones." FontSize="11" Foreground="#8A99AD" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="• Guarda configuraciones de puntos CUE, fades y metadatos extendidos" FontSize="10" Foreground="#6A7382"/>
                                <TextBlock Text="• Permite exportar a CSV para análisis externo" FontSize="10" Foreground="#6A7382" Margin="0,2,0,0"/>
                                <TextBlock Text="• Incluye backup automático ante errores" FontSize="10" Foreground="#6A7382" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <UniformGrid Columns="2" Margin="0,0,0,8">
                                    <Button Command="{Binding SaveMetadataCommand}" Style="{StaticResource SuccessButtonStyle}" Content="💾 Guardar Metadatos" Margin="0,0,4,0" Height="36"/>
                                    <Button Command="{Binding LoadMetadataCommand}" Style="{StaticResource AccentButtonStyle}" Content="📂 Cargar Metadatos" Margin="4,0,0,0" Height="36"/>
                                </UniformGrid>
                                <Button Command="{Binding ExportToCsvCommand}" Style="{StaticResource StudioButtonStyle}" Content="📊 Exportar a CSV" Height="36"/>
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Estadísticas Detalladas -->
                    <Border Grid.Row="1" Background="#161B26" CornerRadius="6" Padding="16" BorderBrush="#262D3D" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📊 ESTADÍSTICAS DE LA BIBLIOTECA" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,0,0,12"/>
                            
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding StatisticsText}" FontSize="12" Foreground="#FFFFFF" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="#0B0D14" CornerRadius="4" Padding="12" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="TOTAL TRACKS" FontSize="10" Foreground="#8A99AD"/>
                                            <TextBlock Text="{Binding DatabaseService.GetTotalTracks()}" FontSize="24" FontWeight="Bold" Foreground="#00E5FF"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="#0B0D14" CornerRadius="4" Padding="12" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="DURACIÓN TOTAL" FontSize="10" Foreground="#8A99AD"/>
                                            <TextBlock Text="{Binding DatabaseService.GetTotalDuration(), StringFormat='{}{0:hh\\:mm\\:ss}'}" FontSize="24" FontWeight="Bold" Foreground="#00C853"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="#0B0D14" CornerRadius="4" Padding="12" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="DURACIÓN PROMEDIO" FontSize="10" Foreground="#8A99AD"/>
                                            <TextBlock Text="{Binding DatabaseService.GetAverageDuration(), StringFormat='{}{0:mm\\:ss}'}" FontSize="24" FontWeight="Bold" Foreground="#FF9100"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- FOOTER -->
        <Border Grid.Row="2" Background="#1A202C" CornerRadius="8" Padding="12,8" Margin="0,12,0,0" BorderBrush="#262D3D" BorderThickness="1">
            <DockPanel>
                <TextBlock Text="ℹ️" FontSize="14" DockPanel.Dock="Left" Margin="0,0,8,0"/>
                <TextBlock Text="Selecciona un track para editar sus propiedades, puntos CUE y metadatos. Los cambios se guardan automáticamente en la sesión actual." FontSize="11" Foreground="#8A99AD" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding EditInfo}" FontSize="10" Foreground="#00E5FF" DockPanel.Dock="Right" FontFamily="Consolas"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>